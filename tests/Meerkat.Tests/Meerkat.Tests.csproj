<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <UseWPF>true</UseWPF>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>
  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Meerkat.App\Meerkat.App.csproj" />
    <ProjectReference Include="..\..\src\Meerkat.Abstractions\Meerkat.Abstractions.csproj" />
    <ProjectReference Include="..\..\src\Meerkat.Ssh\Meerkat.Ssh.csproj" />
    <ProjectReference Include="..\..\src\Meerkat.Widgets.Docker\Meerkat.Widgets.Docker.csproj" />
    <ProjectReference Include="..\..\src\Meerkat.Widgets.Git\Meerkat.Widgets.Git.csproj" />
    <ProjectReference Include="..\..\src\Meerkat.Widgets.Notes\Meerkat.Widgets.Notes.csproj" />
    <ProjectReference Include="..\..\src\Meerkat.Widgets.Server\Meerkat.Widgets.Server.csproj" />
    <ProjectReference Include="..\..\src\Meerkat.Widgets.Services\Meerkat.Widgets.Services.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- Built with the tests but not referenced: it is loaded the way Meerkat loads a plugin, from a folder. -->
    <ProjectReference Include="..\..\samples\Meerkat.Plugins.Sample\Meerkat.Plugins.Sample.csproj" ReferenceOutputAssembly="false" OutputItemType="SamplePlugin" />
  </ItemGroup>
  <Target Name="InstallSamplePlugin" AfterTargets="ResolveProjectReferences" BeforeTargets="AssignTargetPaths">
    <ItemGroup>
      <None Include="@(SamplePlugin)" Link="plugins\%(Filename)\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>
  </Target>
</Project>
