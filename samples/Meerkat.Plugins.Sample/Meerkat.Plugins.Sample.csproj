<Project Sdk="Microsoft.NET.Sdk">
  <!--
    A widget that is not part of Meerkat but loaded from the plugins folder. A plugin of your own
    lives in its own repository and references the package instead of the project:
      <PackageReference Include="Meerkat.Abstractions" Version="1.1.0" ExcludeAssets="runtime" />
  -->
  <PropertyGroup>
    <UseWPF>true</UseWPF>
    <Version>1.0.0</Version>
  </PropertyGroup>
  <ItemGroup>
    <!-- Meerkat brings the contracts itself; a copy in the plugin's folder would only be ignored. -->
    <ProjectReference Include="..\..\src\Meerkat.Abstractions\Meerkat.Abstractions.csproj" Private="false" />
  </ItemGroup>
</Project>