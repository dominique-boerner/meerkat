<UserControl x:Class="Meerkat.Widgets.Services.Views.ServicesSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <SolidColorBrush x:Key="CodeSurface" Color="#FF0E1014" />

        <Style x:Key="LinkButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{DynamicResource Overlay.Accent}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <TextBlock Text="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}" TextDecorations="Underline" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Overlay.TextMuted}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>

        <!-- The templates form one control with three segments, of which exactly one is chosen. -->
        <Style x:Key="Segment" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource Overlay.Text}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Chrome" Background="Transparent" CornerRadius="4" Padding="12,5">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Overlay.SurfaceRaised}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Overlay.Hover}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <StackPanel>
        <DockPanel Margin="0,0,0,6">
            <Button DockPanel.Dock="Right" Content="+ Add service" Command="{Binding AddEndpointCommand}" />
            <TextBlock Style="{DynamicResource Overlay.ColumnHeader}" FontSize="10.5" Text="SERVICES" VerticalAlignment="Center" />
        </DockPanel>

        <ItemsControl ItemsSource="{Binding Endpoints}" Focusable="False">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border BorderBrush="{DynamicResource Overlay.Border}" BorderThickness="0,0,0,1" Padding="0,7">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource Overlay.Text}" />
                            <TextBlock Grid.Column="1" Text="{Binding Url}" FontFamily="{DynamicResource Overlay.MonoFont}" FontSize="11" VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis" Foreground="{DynamicResource Overlay.TextMuted}" />
                            <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="12,0,0,0">
                                <Button Style="{StaticResource LinkButton}" Content="Edit" Margin="0,0,12,0"
                                        Command="{Binding DataContext.EditEndpointCommand, ElementName=Root}" CommandParameter="{Binding}" />
                                <Button Style="{StaticResource LinkButton}" Content="Remove"
                                        Command="{Binding DataContext.RemoveEndpointCommand, ElementName=Root}" CommandParameter="{Binding}" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <TextBlock Text="No services yet." Margin="0,2,0,0" Foreground="{DynamicResource Overlay.TextMuted}">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Endpoints.Count}" Value="0">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>

        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
            <StackPanel.Style>
                <Style TargetType="StackPanel">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Presets.Count}" Value="0">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </StackPanel.Style>
            <TextBlock Text="Add with one click:" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="{DynamicResource Overlay.TextMuted}" />
            <ItemsControl ItemsSource="{Binding Presets}" Focusable="False">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Content="{Binding Name}" Margin="0,0,6,0" Padding="10,3"
                                Command="{Binding DataContext.AddPresetCommand, ElementName=Root}" CommandParameter="{Binding}" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>

        <Border Margin="0,16,0,0"
                Padding="16,14"
                CornerRadius="6"
                BorderThickness="1"
                BorderBrush="{DynamicResource Overlay.Accent}"
                Background="{DynamicResource Overlay.SurfaceSolid}"
                Visibility="{Binding IsFormOpen, Converter={StaticResource BoolToVisibility}}">
            <StackPanel>
                <TextBlock Text="{Binding FormTitle}" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource Overlay.Text}" Margin="0,0,0,10" />

                <TextBlock Style="{StaticResource FieldLabel}" Text="Template" />
                <Border HorizontalAlignment="Left" BorderBrush="{DynamicResource Overlay.Border}" BorderThickness="1" CornerRadius="6" Padding="3" Margin="0,0,0,12">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton Style="{StaticResource Segment}" GroupName="ServiceKind" Content="Status page" IsChecked="{Binding IsStatusPage}" />
                        <RadioButton Style="{StaticResource Segment}" GroupName="ServiceKind" Content="HTTP status" IsChecked="{Binding IsHttpStatus}" />
                        <RadioButton Style="{StaticResource Segment}" GroupName="ServiceKind" Content="Custom JSON" IsChecked="{Binding IsCustomJson}" />
                    </StackPanel>
                </Border>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="130" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,10,0">
                        <TextBlock Style="{StaticResource FieldLabel}" Text="Name" />
                        <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="0,0,10,0">
                        <TextBlock Style="{StaticResource FieldLabel}" Text="{Binding UrlLabel}" />
                        <TextBox Text="{Binding Url, UpdateSourceTrigger=PropertyChanged}" FontFamily="{DynamicResource Overlay.MonoFont}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Style="{StaticResource FieldLabel}" Text="Check" />
                        <ComboBox ItemsSource="{Binding Intervals}" SelectedItem="{Binding SelectedInterval}" DisplayMemberPath="DisplayName" />
                    </StackPanel>
                </Grid>

                <TextBlock Style="{DynamicResource Overlay.Hint}" Margin="0,8,0,0" TextWrapping="Wrap" Text="{Binding RequestHint}" />

                <StackPanel Margin="0,12,0,0" Visibility="{Binding IsCustomJson, Converter={StaticResource BoolToVisibility}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,10,0">
                            <TextBlock Style="{StaticResource FieldLabel}" Text="Path of the state" />
                            <TextBox Text="{Binding StatePath, UpdateSourceTrigger=PropertyChanged}" FontFamily="{DynamicResource Overlay.MonoFont}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Style="{StaticResource FieldLabel}" Text="Path of a description (optional)" />
                            <TextBox Text="{Binding DescriptionPath, UpdateSourceTrigger=PropertyChanged}" FontFamily="{DynamicResource Overlay.MonoFont}" />
                        </StackPanel>
                    </Grid>
                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,10,0">
                            <TextBlock Style="{StaticResource FieldLabel}" Text="Values that mean green, separated by commas" />
                            <TextBox Text="{Binding OkValues, UpdateSourceTrigger=PropertyChanged}" FontFamily="{DynamicResource Overlay.MonoFont}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Style="{StaticResource FieldLabel}" Text="Values that mean yellow (optional)" />
                            <TextBox Text="{Binding WarningValues, UpdateSourceTrigger=PropertyChanged}" FontFamily="{DynamicResource Overlay.MonoFont}" />
                        </StackPanel>
                    </Grid>
                    <TextBlock Style="{DynamicResource Overlay.Hint}" Margin="0,6,0,0" TextWrapping="Wrap">
                        Example: path <Run FontFamily="{DynamicResource Overlay.MonoFont}">status.indicator</Run> or
                        <Run FontFamily="{DynamicResource Overlay.MonoFont}">checks[0].state</Run>, green for
                        <Run FontFamily="{DynamicResource Overlay.MonoFont}">none, ok</Run>. Every value that is neither green nor yellow counts as red.
                    </TextBlock>
                </StackPanel>

                <TextBlock Text="{Binding FormError}" Margin="0,10,0,0" TextWrapping="Wrap" Foreground="{DynamicResource Overlay.Danger}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding FormError}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <Border Margin="0,12,0,0"
                        Padding="12,10"
                        CornerRadius="6"
                        BorderThickness="1"
                        BorderBrush="{DynamicResource Overlay.Border}"
                        Visibility="{Binding HasTestResult, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,8">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <Ellipse x:Name="TestDot" Width="8" Height="8" Margin="0,1,8,0" VerticalAlignment="Center">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Setter Property="Fill" Value="{DynamicResource Overlay.Success}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding TestSeverity}" Value="Warning">
                                                    <Setter Property="Fill" Value="{DynamicResource Overlay.Warning}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding TestSeverity}" Value="Error">
                                                    <Setter Property="Fill" Value="{DynamicResource Overlay.Danger}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                                <TextBlock Text="{Binding TestResultText}" TextTrimming="CharacterEllipsis" MaxWidth="330">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{DynamicResource Overlay.Success}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding TestSeverity}" Value="Warning">
                                                    <Setter Property="Foreground" Value="{DynamicResource Overlay.Warning}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding TestSeverity}" Value="Error">
                                                    <Setter Property="Foreground" Value="{DynamicResource Overlay.Danger}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                            <TextBlock Text="Test request" FontWeight="SemiBold" Foreground="{DynamicResource Overlay.Text}" />
                            <TextBlock Text="{Binding TestSummary}" Margin="10,0,0,0" VerticalAlignment="Center" FontSize="11" Foreground="{DynamicResource Overlay.TextMuted}" />
                        </DockPanel>
                        <Border Background="{StaticResource CodeSurface}" CornerRadius="4" Padding="12,9">
                            <ScrollViewer MaxHeight="170" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Focusable="False">
                                <TextBlock Text="{Binding TestExcerpt}" FontFamily="{DynamicResource Overlay.MonoFont}" FontSize="11.5" Foreground="{DynamicResource Overlay.Text}" />
                            </ScrollViewer>
                        </Border>
                    </StackPanel>
                </Border>

                <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                    <Button Content="Test" Margin="0,0,8,0" Command="{Binding TestCommand}" />
                    <Button Style="{DynamicResource Overlay.PrimaryButton}" Content="Add to the list" Margin="0,0,8,0" Command="{Binding SaveCommand}" />
                    <Button Content="Cancel" Command="{Binding CancelFormCommand}" />
                    <TextBlock Text="Testing …" Margin="12,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource Overlay.TextMuted}"
                               Visibility="{Binding IsTesting, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>
            </StackPanel>
        </Border>

        <TextBlock Style="{DynamicResource Overlay.Hint}" Margin="0,12,0,0" TextWrapping="Wrap"
                   Text="Each check is a single GET request to the address shown; nothing else is sent." />
    </StackPanel>
</UserControl>
