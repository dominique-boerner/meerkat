<UserControl x:Class="Meerkat.Widgets.Services.Views.ServicesHeaderView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontSize="11">
    <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
            <Button Style="{DynamicResource Overlay.IconButton}"
                    Content="&#xE72C;"
                    ToolTip="Check all now"
                    Command="{Binding RefreshCommand}" />
            <Button Style="{DynamicResource Overlay.IconButton}"
                    Content="&#xE713;"
                    ToolTip="Services settings"
                    Command="{Binding OpenSettingsCommand}" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <TextBlock Style="{DynamicResource Overlay.ColumnHeader}" FontSize="10.5" Text="SERVICES" />
            <TextBlock Style="{DynamicResource Overlay.Hint}" Text="{Binding Summary, StringFormat=' · {0}'}" />
        </StackPanel>
    </DockPanel>
</UserControl>
