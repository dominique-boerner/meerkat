<UserControl x:Class="Meerkat.Widgets.Services.Views.ServicesWidgetView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root"
             Foreground="{DynamicResource Overlay.Text}"
             FontSize="12.5">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <SolidColorBrush x:Key="WarningSurface" Color="#1AF2B84B" />
        <SolidColorBrush x:Key="DangerSurface" Color="#1FFF6B6B" />
        <SolidColorBrush x:Key="UnknownDot" Color="#FF5A6170" />

        <!-- Small dot in the color of a severity; expects a WidgetSeverity as data context. -->
        <DataTemplate x:Key="SeverityDot">
            <Ellipse x:Name="Dot" Width="8" Height="8" Fill="{DynamicResource Overlay.Success}" />
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding}" Value="Warning">
                    <Setter TargetName="Dot" Property="Fill" Value="{DynamicResource Overlay.Warning}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding}" Value="Error">
                    <Setter TargetName="Dot" Property="Fill" Value="{DynamicResource Overlay.Danger}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <DataTemplate x:Key="Component">
            <Border Background="{DynamicResource Overlay.SurfaceRaised}" CornerRadius="10" Padding="9,3" Margin="0,0,6,6">
                <StackPanel Orientation="Horizontal">
                    <ContentControl Content="{Binding Severity}" ContentTemplate="{StaticResource SeverityDot}" VerticalAlignment="Center" Margin="0,1,7,0" Focusable="False" />
                    <TextBlock Text="{Binding Name}" />
                </StackPanel>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="Service">
            <Grid>
                <!-- A service that is fine, or whose state is not known yet, takes one quiet line. -->
                <Border x:Name="Row" BorderBrush="{DynamicResource Overlay.Border}" BorderThickness="0,0,0,1" Padding="6,13">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="86" />
                            </Grid.ColumnDefinitions>
                            <Ellipse x:Name="RowDot" Width="8" Height="8" Margin="0,1,12,0" VerticalAlignment="Center" Fill="{StaticResource UnknownDot}" />
                            <TextBlock Grid.Column="1" Text="{Binding Name}" FontWeight="SemiBold" FontSize="13.5" TextTrimming="CharacterEllipsis" />
                            <TextBlock x:Name="RowStatus" Grid.Column="2" Text="{Binding StatusText}" Margin="12,0" VerticalAlignment="Center" Foreground="{DynamicResource Overlay.TextMuted}" />
                            <TextBlock Grid.Column="3" Text="{Binding CheckedText}" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{DynamicResource Overlay.TextMuted}" />
                        </Grid>
                        <TextBlock x:Name="RowError"
                                   Text="{Binding CheckError, StringFormat=Could not be checked: {0}}"
                                   Margin="20,4,0,0"
                                   FontSize="11"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource Overlay.Warning}" />
                    </StackPanel>
                </Border>

                <!-- A service in trouble shows everything it reports about it. -->
                <Border x:Name="Card"
                        Background="{StaticResource WarningSurface}"
                        BorderBrush="{DynamicResource Overlay.Warning}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="16,13,16,10"
                        Margin="0,0,0,8"
                        Visibility="Collapsed">
                    <StackPanel>
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Right" Text="{Binding SinceText}" VerticalAlignment="Center" Foreground="{DynamicResource Overlay.TextMuted}" />
                            <ContentControl Content="{Binding Severity}" ContentTemplate="{StaticResource SeverityDot}" VerticalAlignment="Center" Margin="0,1,12,0" Focusable="False" />
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14.5" />
                            <TextBlock x:Name="CardStatus" Text="{Binding StatusText}" Margin="12,0,12,0" VerticalAlignment="Center" Foreground="{DynamicResource Overlay.Warning}" TextTrimming="CharacterEllipsis" />
                        </DockPanel>
                        <TextBlock x:Name="IncidentText" Text="{Binding Incident}" Margin="0,8,0,0" FontSize="13" TextWrapping="Wrap" />
                        <TextBlock x:Name="UpdateText" Text="{Binding LatestUpdateText}" Margin="0,6,0,0" TextWrapping="Wrap" MaxHeight="68" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource Overlay.TextMuted}" />
                        <ItemsControl ItemsSource="{Binding Components}" ItemTemplate="{StaticResource Component}" Margin="0,10,0,0" Focusable="False">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                        <TextBlock x:Name="CardError"
                                   Text="{Binding CheckError, StringFormat=The last check failed: {0}}"
                                   Margin="0,4,0,6"
                                   FontSize="11"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource Overlay.TextMuted}" />
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <Button Content="Open status page" Margin="0,0,8,0"
                                    Command="{Binding DataContext.OpenPageCommand, ElementName=Root}" CommandParameter="{Binding}" />
                            <Button x:Name="MuteButton" Content="Mute until resolved"
                                    Command="{Binding DataContext.ToggleMuteCommand, ElementName=Root}" CommandParameter="{Binding}" />
                            <TextBlock x:Name="MutedHint" Text="Muted – not shown in the status bar" Margin="12,0,0,0" VerticalAlignment="Center" FontSize="11" Foreground="{DynamicResource Overlay.TextMuted}" Visibility="Collapsed" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
            <DataTemplate.Triggers>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsKnown}" Value="True" />
                        <Condition Binding="{Binding IsProblem}" Value="False" />
                    </MultiDataTrigger.Conditions>
                    <Setter TargetName="RowDot" Property="Fill" Value="{DynamicResource Overlay.Success}" />
                    <Setter TargetName="RowStatus" Property="Foreground" Value="{DynamicResource Overlay.Success}" />
                </MultiDataTrigger>
                <DataTrigger Binding="{Binding IsProblem}" Value="True">
                    <Setter TargetName="Row" Property="Visibility" Value="Collapsed" />
                    <Setter TargetName="Card" Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Severity}" Value="Error">
                    <Setter TargetName="Card" Property="Background" Value="{StaticResource DangerSurface}" />
                    <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource Overlay.Danger}" />
                    <Setter TargetName="CardStatus" Property="Foreground" Value="{DynamicResource Overlay.Danger}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsMuted}" Value="True">
                    <Setter TargetName="MuteButton" Property="Content" Value="Unmute" />
                    <Setter TargetName="MutedHint" Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Incident}" Value="{x:Null}">
                    <Setter TargetName="IncidentText" Property="Visibility" Value="Collapsed" />
                </DataTrigger>
                <DataTrigger Binding="{Binding LatestUpdateText}" Value="{x:Null}">
                    <Setter TargetName="UpdateText" Property="Visibility" Value="Collapsed" />
                </DataTrigger>
                <DataTrigger Binding="{Binding CheckError}" Value="{x:Null}">
                    <Setter TargetName="RowError" Property="Visibility" Value="Collapsed" />
                    <Setter TargetName="CardError" Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </UserControl.Resources>

    <!-- The heading with its buttons is the widget's header view, which the panel shows above this page. -->
    <DockPanel>
        <StackPanel DockPanel.Dock="Top" Margin="0,24,0,0" HorizontalAlignment="Center" Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}">
            <TextBlock Text="No services yet" FontWeight="SemiBold" FontSize="14" HorizontalAlignment="Center" />
            <TextBlock Text="Add the status pages of the services your work depends on, such as your package registry or code hosting. Meerkat tells you when one of them reports trouble."
                       Margin="0,6,0,14" MaxWidth="380" TextWrapping="Wrap" TextAlignment="Center" Foreground="{DynamicResource Overlay.TextMuted}" />
            <Button Style="{DynamicResource Overlay.PrimaryButton}" Content="Add services" HorizontalAlignment="Center" Command="{Binding OpenSettingsCommand}" />
        </StackPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
            <ItemsControl ItemsSource="{Binding Services}" ItemTemplate="{StaticResource Service}" Focusable="False" />
        </ScrollViewer>
    </DockPanel>
</UserControl>
