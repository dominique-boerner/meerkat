<UserControl x:Class="Meerkat.Widgets.Notes.Views.NotesHeaderView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontSize="11">
    <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
            <Button Style="{DynamicResource Overlay.IconButton}"
                    Content="&#xE8B7;"
                    ToolTip="Open the notes folder"
                    Command="{Binding OpenFolderCommand}" />
            <Button Style="{DynamicResource Overlay.IconButton}"
                    Content="&#xE713;"
                    ToolTip="Notes settings"
                    Command="{Binding OpenSettingsCommand}" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <TextBlock Style="{DynamicResource Overlay.ColumnHeader}" FontSize="10.5" Text="NOTES" />
            <TextBlock Style="{DynamicResource Overlay.Hint}" Text="{Binding Summary, StringFormat=' · {0}'}" />
        </StackPanel>
    </DockPanel>
</UserControl>
