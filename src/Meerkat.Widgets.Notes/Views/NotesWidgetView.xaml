<UserControl x:Class="Meerkat.Widgets.Notes.Views.NotesWidgetView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:Meerkat.Widgets.Notes.Views"
             x:Name="Root"
             Foreground="{DynamicResource Overlay.Text}"
             FontSize="12.5"
             PreviewMouseDown="OnPreviewMouseDown">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <SolidColorBrush x:Key="CodeSurface" Color="#FF0E1014" />

        <DataTemplate x:Key="NoteItem">
            <Button Command="{Binding DataContext.SelectCommand, ElementName=Root}" CommandParameter="{Binding}" Cursor="Hand" FocusVisualStyle="{x:Null}">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="6" Padding="9,6" Margin="0,1">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock x:Name="Pin"
                                               Text="&#xE718;"
                                               FontFamily="{DynamicResource Overlay.IconFont}"
                                               FontSize="10"
                                               Foreground="{DynamicResource Overlay.Accent}"
                                               VerticalAlignment="Center"
                                               Margin="0,0,6,0"
                                               Visibility="Collapsed" />
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <TextBlock Text="{Binding DateText}" FontSize="11" Foreground="{DynamicResource Overlay.TextMuted}" Margin="0,1,0,0" />
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Overlay.SurfaceRaised}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource Overlay.Accent}" />
                            </Trigger>
                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Overlay.Hover}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsScratchpad}" Value="True">
                                <Setter TargetName="Pin" Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </DataTemplate>

        <DataTemplate x:Key="Line">
            <Grid Margin="0,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <CheckBox x:Name="Check"
                          IsChecked="{Binding IsDone, Mode=OneWay}"
                          Command="{Binding ToggleCommand}"
                          Margin="0,1,9,0"
                          VerticalAlignment="Top"
                          Cursor="Hand"
                          Focusable="False"
                          Visibility="Collapsed" />
                <TextBlock x:Name="Dot" Text="•" Margin="3,0,9,0" Foreground="{DynamicResource Overlay.TextMuted}" Visibility="Collapsed" />
                <TextBlock x:Name="Time"
                           Text="{Binding Time}"
                           FontFamily="{DynamicResource Overlay.MonoFont}"
                           FontSize="11"
                           Margin="0,2,8,0"
                           Foreground="{DynamicResource Overlay.TextMuted}"
                           Visibility="Collapsed" />
                <views:MarkdownTextBlock x:Name="Body" Grid.Column="1" Markdown="{Binding Text}" TextWrapping="Wrap" />
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Kind}" Value="Task">
                    <Setter TargetName="Check" Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="Bullet">
                    <Setter TargetName="Dot" Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="Timed">
                    <Setter TargetName="Time" Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsDone}" Value="True">
                    <Setter TargetName="Body" Property="TextDecorations" Value="Strikethrough" />
                    <Setter TargetName="Body" Property="Foreground" Value="{DynamicResource Overlay.TextMuted}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <DataTemplate x:Key="TextBlockContent">
            <ItemsControl ItemsSource="{Binding Lines}" ItemTemplate="{StaticResource Line}" Focusable="False" Margin="0,2" />
        </DataTemplate>

        <DataTemplate x:Key="HeadingContent">
            <TextBlock x:Name="Heading" Text="{Binding HeadingText}" FontWeight="SemiBold" FontSize="13" TextWrapping="Wrap" Margin="0,10,0,2" />
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding HeadingLevel}" Value="1">
                    <Setter TargetName="Heading" Property="FontSize" Value="20" />
                </DataTrigger>
                <DataTrigger Binding="{Binding HeadingLevel}" Value="2">
                    <Setter TargetName="Heading" Property="FontSize" Value="17" />
                </DataTrigger>
                <DataTrigger Binding="{Binding HeadingLevel}" Value="3">
                    <Setter TargetName="Heading" Property="FontSize" Value="14" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsDateLine}" Value="True">
                    <Setter TargetName="Heading" Property="FontSize" Value="11" />
                    <Setter TargetName="Heading" Property="FontWeight" Value="Normal" />
                    <Setter TargetName="Heading" Property="Foreground" Value="{DynamicResource Overlay.TextMuted}" />
                    <Setter TargetName="Heading" Property="Margin" Value="0,6,0,0" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <DataTemplate x:Key="CodeContent">
            <Border Background="{StaticResource CodeSurface}"
                    BorderBrush="{DynamicResource Overlay.Border}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="12,9"
                    Margin="0,4">
                <TextBlock Text="{Binding CodeText}" FontFamily="{DynamicResource Overlay.MonoFont}" FontSize="12" TextWrapping="Wrap" />
            </Border>
        </DataTemplate>

        <!-- A block is shown rendered; a click turns it into its Markdown source until the focus moves on. -->
        <DataTemplate x:Key="Block">
<Grid x:Name="BlockRoot"
                  Background="Transparent"
                  Cursor="IBeam"
                  Focusable="True"
                  FocusVisualStyle="{x:Null}"
                  MouseLeftButtonUp="OnBlockClicked"
                  KeyDown="OnBlockKeyDown">
                <Rectangle x:Name="Outline"
                           Stroke="{DynamicResource Overlay.Border}"
                           StrokeDashArray="3 3"
                           RadiusX="5"
                           RadiusY="5"
                           Margin="-7,0"
                           IsHitTestVisible="False"
                           Visibility="Hidden" />
                <ContentControl x:Name="Rendered" Content="{Binding}" ContentTemplate="{StaticResource TextBlockContent}" Focusable="False" />
                <TextBox x:Name="Editor"
                         Text="{Binding EditText, UpdateSourceTrigger=PropertyChanged}"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         FontFamily="{DynamicResource Overlay.MonoFont}"
                         FontSize="12"
                         Padding="6,5"
                         Margin="-7,2"
                         Visibility="Collapsed"
                         Loaded="OnEditorShown"
                         IsVisibleChanged="OnEditorVisibleChanged"
                         LostKeyboardFocus="OnEditorLostFocus"
                         PreviewKeyDown="OnEditorKeyDown" />
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Kind}" Value="Heading">
                    <Setter TargetName="Rendered" Property="ContentTemplate" Value="{StaticResource HeadingContent}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="Code">
                    <Setter TargetName="Rendered" Property="ContentTemplate" Value="{StaticResource CodeContent}" />
                </DataTrigger>
                <Trigger SourceName="BlockRoot" Property="IsMouseOver" Value="True">
                    <Setter TargetName="Outline" Property="Visibility" Value="Visible" />
                </Trigger>
                <Trigger SourceName="BlockRoot" Property="IsKeyboardFocused" Value="True">
                    <Setter TargetName="Outline" Property="Visibility" Value="Visible" />
                    <Setter TargetName="Outline" Property="Stroke" Value="{DynamicResource Overlay.Accent}" />
                </Trigger>
                <DataTrigger Binding="{Binding IsEditing}" Value="True">
                    <Setter TargetName="Rendered" Property="Visibility" Value="Collapsed" />
                    <Setter TargetName="Outline" Property="Visibility" Value="Hidden" />
                    <Setter TargetName="Editor" Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsHidden}" Value="True">
                    <Setter TargetName="BlockRoot" Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="182" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" BorderBrush="{DynamicResource Overlay.Border}" BorderThickness="0,0,1,0">
            <!-- Flush with the header above on the left and at the top, like the content of every other page. -->
            <DockPanel Margin="0,0,10,0">
                <Grid DockPanel.Dock="Top" Margin="0,0,0,6">
                    <TextBox x:Name="SearchBox" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Padding="26,5,6,5" />
                    <TextBlock Text="&#xE721;"
                               FontFamily="{DynamicResource Overlay.IconFont}"
                               FontSize="11"
                               Foreground="{DynamicResource Overlay.TextMuted}"
                               Margin="10,0,0,0"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Left"
                               IsHitTestVisible="False" />
                    <TextBlock Text="Search …" Foreground="{DynamicResource Overlay.TextMuted}" Margin="33,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SearchText}" Value="">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
                <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
                    <StackPanel>
                        <ItemsControl ItemsSource="{Binding Notes}" ItemTemplate="{StaticResource NoteItem}" Focusable="False" />
                        <Button Command="{Binding NewNoteCommand}" Cursor="Hand" Margin="0,8,0,0" FocusVisualStyle="{x:Null}">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Grid Background="Transparent">
                                        <Rectangle x:Name="Frame" Stroke="{DynamicResource Overlay.Border}" StrokeDashArray="3 3" RadiusX="6" RadiusY="6" />
                                        <TextBlock x:Name="Label" Text="+ New note" HorizontalAlignment="Center" Margin="0,8" Foreground="{DynamicResource Overlay.TextMuted}" />
                                    </Grid>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Label" Property="Foreground" Value="{DynamicResource Overlay.Text}" />
                                            <Setter TargetName="Frame" Property="Stroke" Value="{DynamicResource Overlay.TextMuted}" />
                                        </Trigger>
                                        <Trigger Property="IsKeyboardFocused" Value="True">
                                            <Setter TargetName="Label" Property="Foreground" Value="{DynamicResource Overlay.Text}" />
                                            <Setter TargetName="Frame" Property="Stroke" Value="{DynamicResource Overlay.Accent}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <DockPanel Grid.Column="1">
            <Border DockPanel.Dock="Top" BorderBrush="{DynamicResource Overlay.Border}" BorderThickness="0,0,0,1" Padding="16,0,0,6">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Command="{Binding TogglePinCommand}"
                                Padding="8,6"
                                FontSize="12"
                                ToolTip="Show the tasks below the status bar"
                                Visibility="{Binding IsScratchpad, Converter={StaticResource BoolToVisibility}}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource Overlay.IconButton}">
                                    <Setter Property="Content" Value="&#xE718;" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsPinned}" Value="True">
                                            <Setter Property="Content" Value="&#xE840;" />
                                            <Setter Property="Foreground" Value="{DynamicResource Overlay.Accent}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Style="{DynamicResource Overlay.IconButton}" Content="&#xE8A7;" Padding="8,6" FontSize="12"
                                ToolTip="Open in the default editor" Command="{Binding OpenExternallyCommand}" />
                        <Button Content="&#xE74D;" Padding="8,6" FontSize="12"
                                ToolTip="Move this note to the recycle bin" Command="{Binding DeleteNoteCommand}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource Overlay.IconButton}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsScratchpad}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>
                    <TextBlock x:Name="SaveStateText" DockPanel.Dock="Right" Text="{Binding SaveState}" FontSize="11" VerticalAlignment="Center" Margin="10,0" TextTrimming="CharacterEllipsis" MaxWidth="220">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{DynamicResource Overlay.TextMuted}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasError}" Value="True">
                                        <Setter Property="Foreground" Value="{DynamicResource Overlay.Danger}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <Grid VerticalAlignment="Center">
                        <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"
                                   Visibility="{Binding IsScratchpad, Converter={StaticResource BoolToVisibility}}" />
                        <TextBox x:Name="TitleBox"
                                 Text="{Binding Title, Mode=OneWay}"
                                 FontSize="14"
                                 FontWeight="SemiBold"
                                 Background="Transparent"
                                 BorderBrush="Transparent"
                                 Padding="0,2"
                                 Margin="-1,0,0,0"
                                 ToolTip="Click to rename the note"
                                 LostKeyboardFocus="OnTitleLostFocus"
                                 PreviewKeyDown="OnTitleKeyDown">
                            <TextBox.Style>
                                <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsScratchpad}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBox.Style>
                        </TextBox>
                    </Grid>
                </DockPanel>
            </Border>

            <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource Overlay.Border}" BorderThickness="0,1,0,0" Padding="16,6,0,0">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Right" Text="Ctrl+Enter new block · Tab next · Esc done" FontSize="10.5" Foreground="{DynamicResource Overlay.TextMuted}" Margin="12,0,0,0" />
                    <TextBlock Text="{Binding PathText}" FontFamily="{DynamicResource Overlay.MonoFont}" FontSize="10.5" Foreground="{DynamicResource Overlay.TextMuted}" TextTrimming="CharacterEllipsis" />
                </DockPanel>
            </Border>

            <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
                <StackPanel Margin="18,8,12,12">
                    <ItemsControl x:Name="BlockList" ItemsSource="{Binding Blocks}" ItemTemplate="{StaticResource Block}" Focusable="False" />
                    <Border x:Name="AddArea"
                            Background="Transparent"
                            Cursor="IBeam"
                            MinHeight="72"
                            Margin="0,8,0,0"
                            Focusable="True"
                            FocusVisualStyle="{x:Null}"
                            MouseLeftButtonUp="OnAddBlockClicked"
                            KeyDown="OnAddAreaKeyDown">
                        <TextBlock Text="Click or press Enter to write …" Margin="0,4">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{DynamicResource Overlay.TextMuted}" />
                                    <Setter Property="Opacity" Value="0.7" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsKeyboardFocused, ElementName=AddArea}" Value="True">
                                            <Setter Property="Foreground" Value="{DynamicResource Overlay.Accent}" />
                                            <Setter Property="Opacity" Value="1" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </DockPanel>
    </Grid>
</UserControl>
