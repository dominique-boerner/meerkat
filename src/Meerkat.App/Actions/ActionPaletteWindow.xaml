<Window x:Class="Meerkat.App.Actions.ActionPaletteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Meerkat.App.Actions"
        xmlns:abstractions="clr-namespace:Meerkat.Abstractions;assembly=Meerkat.Abstractions"
        Title="Meerkat"
        Width="720"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI"
        FontSize="13"
        Foreground="{StaticResource Overlay.Text}"
        PreviewKeyDown="OnPreviewKeyDown">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <Style x:Key="Key" TargetType="Border">
            <Setter Property="BorderBrush" Value="{StaticResource Overlay.Border}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="6,1" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="KeyText" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource Overlay.MonoFont}" />
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="Foreground" Value="{StaticResource Overlay.TextMuted}" />
        </Style>
        <Style x:Key="StateIcon" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource Overlay.IconFont}" />
            <Setter Property="FontSize" Value="20" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="Margin" Value="0,1,12,0" />
        </Style>
    </Window.Resources>

    <!-- The margin leaves room for the shadow, which a borderless window would otherwise clip. -->
    <Border Margin="24"
            Background="{StaticResource Overlay.SurfaceSolid}"
            BorderBrush="{StaticResource Overlay.Border}"
            BorderThickness="1"
            CornerRadius="10">
        <Border.Effect>
            <DropShadowEffect BlurRadius="28" ShadowDepth="6" Opacity="0.5" />
        </Border.Effect>
        <StackPanel>
            <!-- The field, with what was chosen so far in front of it. -->
            <DockPanel Margin="16,12">
                <Image DockPanel.Dock="Left"
                       Source="/Assets/meerkat-app.ico"
                       Width="20"
                       Height="20"
                       RenderOptions.BitmapScalingMode="HighQuality"
                       VerticalAlignment="Center"
                       Margin="0,0,12,0" />
                <Border DockPanel.Dock="Right" Style="{StaticResource Key}">
                    <TextBlock Style="{StaticResource KeyText}" Text="Esc" />
                </Border>
                <Border DockPanel.Dock="Left"
                        Background="{StaticResource Overlay.Hover}"
                        CornerRadius="4"
                        Padding="8,3"
                        Margin="0,0,10,0"
                        VerticalAlignment="Center"
                        Visibility="{Binding HasChip, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="{Binding Chip}" FontWeight="SemiBold" Foreground="{StaticResource Overlay.Accent}" FontSize="12" />
                </Border>
                <Grid VerticalAlignment="Center">
                    <TextBlock x:Name="PlaceholderText"
                               Text="{Binding Placeholder}"
                               FontSize="16"
                               Foreground="{StaticResource Overlay.TextMuted}"
                               IsHitTestVisible="False"
                               Margin="2,0,0,0"
                               Visibility="Collapsed" />
                    <TextBox x:Name="Input"
                             Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}"
                             FontSize="16"
                             Background="Transparent"
                             BorderThickness="0"
                             Padding="0"
                             Foreground="{StaticResource Overlay.Text}"
                             CaretBrush="{StaticResource Overlay.Text}"
                             IsReadOnly="{Binding IsChoosing, Converter={x:Static local:InvertBoolean.Instance}}"
                             TextChanged="OnInputChanged" />
                </Grid>
            </DockPanel>

            <!-- First and second step: the actions, then what to apply the chosen one to. -->
            <Border BorderBrush="{StaticResource Overlay.Border}"
                    BorderThickness="0,1,0,0"
                    Visibility="{Binding IsChoosing, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                    <ScrollViewer x:Name="RowsScroll" MaxHeight="440" VerticalScrollBarVisibility="Auto" Focusable="False">
                        <ItemsControl x:Name="RowsList" ItemsSource="{Binding Rows}" Focusable="False" Margin="6,2,6,8">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <TextBlock x:Name="Group"
                                                   Text="{Binding Group}"
                                                   Style="{StaticResource Overlay.ColumnHeader}"
                                                   FontSize="10.5"
                                                   Margin="10,10,0,4" />
                                        <Border x:Name="Chrome"
                                                Background="Transparent"
                                                CornerRadius="6"
                                                Padding="10,7"
                                                Cursor="Hand"
                                                MouseLeftButtonUp="OnRowClick">
                                            <DockPanel x:Name="Content">
                                                <Border x:Name="EnterKey" DockPanel.Dock="Right" Style="{StaticResource Key}" Visibility="Collapsed">
                                                    <TextBlock Style="{StaticResource KeyText}" Text="Enter" />
                                                </Border>
                                                <Grid DockPanel.Dock="Left" Width="20" Margin="0,0,10,0" VerticalAlignment="Center">
                                                    <TextBlock x:Name="Icon"
                                                               Text="{Binding Icon}"
                                                               FontFamily="{StaticResource Overlay.IconFont}"
                                                               FontSize="14"
                                                               HorizontalAlignment="Center"
                                                               Foreground="{StaticResource Overlay.TextMuted}" />
                                                    <Ellipse x:Name="Dot"
                                                             Width="8"
                                                             Height="8"
                                                             Fill="{StaticResource Overlay.Success}"
                                                             Visibility="{Binding HasDot, Converter={StaticResource BoolToVisibility}}" />
                                                </Grid>
                                                <TextBlock local:HighlightedText.Segments="{Binding Title}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding Hint}"
                                                           Margin="10,1,0,0"
                                                           FontSize="12"
                                                           Foreground="{StaticResource Overlay.TextMuted}"
                                                           VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis" />
                                            </DockPanel>
                                        </Border>
                                    </StackPanel>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding Group}" Value="{x:Null}">
                                            <Setter TargetName="Group" Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding HasDot}" Value="True">
                                            <Setter TargetName="Icon" Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Severity}" Value="{x:Static abstractions:WidgetSeverity.Warning}">
                                            <Setter TargetName="Dot" Property="Fill" Value="{StaticResource Overlay.Warning}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Severity}" Value="{x:Static abstractions:WidgetSeverity.Error}">
                                            <Setter TargetName="Dot" Property="Fill" Value="{StaticResource Overlay.Danger}" />
                                        </DataTrigger>
                                        <Trigger SourceName="Chrome" Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Chrome" Property="Background" Value="{StaticResource Overlay.SurfaceRaised}" />
                                        </Trigger>
                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                            <Setter TargetName="Chrome" Property="Background" Value="{StaticResource Overlay.Hover}" />
                                            <Setter TargetName="EnterKey" Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                        <!-- What cannot be chosen is listed all the same, so that nobody looks for it in vain. -->
                                        <DataTrigger Binding="{Binding IsAvailable}" Value="False">
                                            <Setter TargetName="Content" Property="Opacity" Value="0.45" />
                                            <Setter TargetName="Chrome" Property="Cursor" Value="Arrow" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <DockPanel Margin="16,14,16,16" Visibility="{Binding HasEmptyText, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Visibility="{Binding HasTextOffer, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="{Binding TextOffer}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <Border Style="{StaticResource Key}">
                                <TextBlock Style="{StaticResource KeyText}" Text="Enter" />
                            </Border>
                        </StackPanel>
                        <TextBlock Text="{Binding EmptyText}" Foreground="{StaticResource Overlay.TextMuted}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    </DockPanel>
                </StackPanel>
            </Border>

            <!-- A question before something that cannot be undone, or that others would notice. -->
            <Border BorderBrush="{StaticResource Overlay.Border}"
                    BorderThickness="0,1,0,0"
                    Padding="16,16,16,18"
                    Visibility="{Binding IsConfirmation, Converter={StaticResource BoolToVisibility}}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Left" Style="{StaticResource StateIcon}" Text="&#xE7BA;" Foreground="{StaticResource Overlay.Warning}" />
                    <StackPanel>
                        <TextBlock Text="{Binding Message}" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding Detail}" Foreground="{StaticResource Overlay.TextMuted}" TextWrapping="Wrap" Margin="0,3,0,0" />
                        <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                            <Button Style="{StaticResource Overlay.PrimaryButton}" Click="OnAcceptClick" Margin="0,0,8,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding PrimaryText}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    <TextBlock Text="Enter" FontFamily="{StaticResource Overlay.MonoFont}" FontSize="10.5" Opacity="0.7" Margin="8,1,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button Click="OnBackClick">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Cancel" VerticalAlignment="Center" />
                                    <TextBlock Text="Esc" FontFamily="{StaticResource Overlay.MonoFont}" FontSize="10.5" Opacity="0.7" Margin="8,1,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </DockPanel>
            </Border>

            <Border BorderBrush="{StaticResource Overlay.Border}"
                    BorderThickness="0,1,0,0"
                    Padding="16,16,16,18"
                    Visibility="{Binding IsRunning, Converter={StaticResource BoolToVisibility}}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Left" Style="{StaticResource StateIcon}" Text="&#xE916;" Foreground="{StaticResource Overlay.TextMuted}" />
                    <TextBlock Text="{Binding Message}" FontSize="14" Foreground="{StaticResource Overlay.TextMuted}" VerticalAlignment="Center" TextWrapping="Wrap" />
                </DockPanel>
            </Border>

            <!-- A success is only said; the palette closes on its own. -->
            <Border BorderBrush="{StaticResource Overlay.Border}"
                    BorderThickness="0,1,0,0"
                    Padding="16,16,16,18"
                    Visibility="{Binding IsSucceeded, Converter={StaticResource BoolToVisibility}}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Left" Style="{StaticResource StateIcon}" Text="&#xE930;" Foreground="{StaticResource Overlay.Success}" />
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding Message}" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding Detail}"
                                   Foreground="{StaticResource Overlay.TextMuted}"
                                   TextWrapping="Wrap"
                                   Margin="0,3,0,0"
                                   Visibility="{Binding HasDetail, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- A failure stays until it was read, and leads to the page where it can be looked into. -->
            <Border BorderBrush="{StaticResource Overlay.Border}"
                    BorderThickness="0,1,0,0"
                    Padding="16,16,16,18"
                    Visibility="{Binding IsFailed, Converter={StaticResource BoolToVisibility}}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Left" Style="{StaticResource StateIcon}" Text="&#xEA39;" Foreground="{StaticResource Overlay.Danger}" />
                    <StackPanel>
                        <TextBlock Text="{Binding Message}" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding Detail}"
                                   Foreground="{StaticResource Overlay.Danger}"
                                   TextWrapping="Wrap"
                                   Margin="0,3,0,0"
                                   Visibility="{Binding HasDetail, Converter={StaticResource BoolToVisibility}}" />
                        <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                            <Button Click="OnAcceptClick" Margin="0,0,8,0" Visibility="{Binding HasPrimaryAction, Converter={StaticResource BoolToVisibility}}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding PrimaryText}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    <TextBlock Text="Enter" FontFamily="{StaticResource Overlay.MonoFont}" FontSize="10.5" Opacity="0.7" Margin="8,1,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button Click="OnBackClick">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Close" VerticalAlignment="Center" />
                                    <TextBlock Text="Esc" FontFamily="{StaticResource Overlay.MonoFont}" FontSize="10.5" Opacity="0.7" Margin="8,1,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </DockPanel>
            </Border>
        </StackPanel>
    </Border>
</Window>
