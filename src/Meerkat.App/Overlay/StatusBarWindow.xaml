<Window x:Class="Meerkat.App.Overlay.StatusBarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Meerkat"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        ResizeMode="NoResize"
        Focusable="False"
        FontFamily="Segoe UI"
        FontSize="12">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <SolidColorBrush x:Key="DangerSurface" Color="#33FF6B6B" />
        <SolidColorBrush x:Key="WarningSurface" Color="#2EF2B84B" />

        <!-- A clickable area that keeps the look of its content and only lightens slightly under the pointer. -->
        <Style x:Key="CardButton" TargetType="Button">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Margin" Value="0,6,0,0" />
            <Setter Property="Command" Value="{Binding DataContext.OpenWidgetCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <ContentPresenter />
                            <Border x:Name="Highlight" Background="#12FFFFFF" CornerRadius="8" IsHitTestVisible="False" Visibility="Collapsed" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Highlight" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Highlight" Property="Background" Value="#20FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BarButton" TargetType="Button" BasedOn="{StaticResource CardButton}">
            <Setter Property="Margin" Value="0" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="Command" Value="{Binding TogglePanelCommand}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <ContentPresenter />
                            <Border x:Name="Highlight" Background="#12FFFFFF" CornerRadius="14" IsHitTestVisible="False" Visibility="Collapsed" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Highlight" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Highlight" Property="Background" Value="#20FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="Chip">
            <Border x:Name="Chrome" CornerRadius="10" Padding="8,2" Margin="2,0" Background="Transparent">
                <StackPanel Orientation="Horizontal">
                    <Ellipse x:Name="Dot" Width="6" Height="6" Margin="0,1,6,0" Fill="{StaticResource Overlay.Success}" />
                    <TextBlock Text="{Binding Label}" Foreground="{StaticResource Overlay.Text}" />
                    <TextBlock Text="{Binding Summary}"
                               Margin="6,0,0,0"
                               FontFamily="{StaticResource Overlay.MonoFont}"
                               FontSize="11"
                               VerticalAlignment="Center"
                               Foreground="{StaticResource Overlay.TextMuted}" />
                </StackPanel>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Severity}" Value="Warning">
                    <Setter TargetName="Dot" Property="Fill" Value="{StaticResource Overlay.Warning}" />
                    <Setter TargetName="Chrome" Property="Background" Value="{StaticResource WarningSurface}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Severity}" Value="Error">
                    <Setter TargetName="Dot" Property="Fill" Value="{StaticResource Overlay.Danger}" />
                    <Setter TargetName="Chrome" Property="Background" Value="{StaticResource DangerSurface}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <DataTemplate x:Key="AlertCard">
            <Button Style="{StaticResource CardButton}" CommandParameter="{Binding WidgetId}">
            <Border Background="{StaticResource Overlay.Surface}" CornerRadius="8" Padding="12,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid Grid.Column="0" Width="18" Height="18" Margin="0,0,12,0" VerticalAlignment="Center">
                        <Ellipse Fill="{StaticResource Overlay.Danger}" />
                        <TextBlock Text="&#xE711;"
                                   FontFamily="{StaticResource Overlay.IconFont}"
                                   FontSize="9"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource Overlay.SurfaceSolid}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Grid>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Foreground="{StaticResource Overlay.Text}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding Detail}" FontSize="11" Foreground="{StaticResource Overlay.Text}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <TextBlock Grid.Column="2"
                               Text="{Binding AgeText}"
                               FontSize="10.5"
                               Margin="12,1,0,0"
                               VerticalAlignment="Top"
                               Foreground="{StaticResource Overlay.TextMuted}" />
                </Grid>
            </Border>
            </Button>
        </DataTemplate>

        <DataTemplate x:Key="StatusCard">
            <Button Style="{StaticResource CardButton}" CommandParameter="{Binding WidgetId}">
            <Border Background="{StaticResource Overlay.Surface}" CornerRadius="8" Padding="12,8">
                <StackPanel>
                    <TextBlock Text="{Binding Card.Title}" FontSize="10.5" Foreground="{StaticResource Overlay.TextMuted}" Margin="0,0,0,2" />
                    <ItemsControl ItemsSource="{Binding Card.Lines}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock x:Name="Line" Text="{Binding Text}" Foreground="{StaticResource Overlay.Text}" TextTrimming="CharacterEllipsis" Margin="0,1" />
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsDone}" Value="True">
                                        <Setter TargetName="Line" Property="TextDecorations" Value="Strikethrough" />
                                        <Setter TargetName="Line" Property="Foreground" Value="{StaticResource Overlay.TextMuted}" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
            </Button>
        </DataTemplate>
    </Window.Resources>

    <!-- Everything is aligned to the top right corner and sized by its content, so the rest of the screen stays free. -->
    <StackPanel HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,12,16,0" Width="390">
        <Button Style="{StaticResource BarButton}">
        <Border CornerRadius="14" Padding="10,5,6,5" Background="{StaticResource Overlay.Surface}">
            <StackPanel Orientation="Horizontal">
                <!-- The hotkey is there for those who look for it, without taking space from everyone else. -->
                <Image Source="/Assets/meerkat-app.ico"
                       Width="16"
                       Height="16"
                       Margin="0,0,6,0"
                       ToolTip="{Binding DetailsToolTip}"
                       ToolTipService.InitialShowDelay="300"
                       RenderOptions.BitmapScalingMode="HighQuality" />
                <ItemsControl ItemsSource="{Binding Chips}" ItemTemplate="{StaticResource Chip}" Focusable="False">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </StackPanel>
        </Border>
        </Button>

        <ItemsControl ItemsSource="{Binding Alerts}" ItemTemplate="{StaticResource AlertCard}" Focusable="False" />

        <Button>
            <Button.Style>
                <Style TargetType="Button" BasedOn="{StaticResource CardButton}">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding MoreHintsCount}" Value="{x:Null}">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Button.Style>
        <Border Background="{StaticResource Overlay.Surface}" CornerRadius="8" Padding="12,7">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding MoreHintsCount}"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource Overlay.Warning}"
                           Width="30" />
                <TextBlock Text="{Binding MoreHintsText}" Foreground="{StaticResource Overlay.Text}" />
            </StackPanel>
        </Border>
        </Button>

        <ItemsControl ItemsSource="{Binding Cards}" ItemTemplate="{StaticResource StatusCard}" Focusable="False" />

        <Button HorizontalAlignment="Right">
            <Button.Style>
                <Style TargetType="Button" BasedOn="{StaticResource CardButton}">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Notice}" Value="{x:Null}">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Button.Style>
        <Border Background="{StaticResource Overlay.Surface}" CornerRadius="8" Padding="10,4">
            <StackPanel Orientation="Horizontal">
                <Ellipse Width="5" Height="5" Margin="0,1,6,0" Fill="{StaticResource Overlay.Accent}" />
                <TextBlock Text="{Binding Notice}" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource Overlay.Accent}" />
            </StackPanel>
        </Border>
        </Button>
    </StackPanel>
</Window>
