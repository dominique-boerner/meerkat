<Window x:Class="Meerkat.App.Overlay.StatusBarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Meerkat"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        ResizeMode="NoResize"
        Focusable="False"
        IsHitTestVisible="False"
        FontFamily="Segoe UI"
        FontSize="12">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <SolidColorBrush x:Key="DangerSurface" Color="#33FF6B6B" />
        <SolidColorBrush x:Key="WarningSurface" Color="#2EF2B84B" />

        <DataTemplate x:Key="Chip">
            <Border x:Name="Chrome" CornerRadius="10" Padding="8,2" Margin="2,0" Background="Transparent">
                <StackPanel Orientation="Horizontal">
                    <Ellipse x:Name="Dot" Width="6" Height="6" Margin="0,1,6,0" Fill="{StaticResource Overlay.Success}" />
                    <TextBlock Text="{Binding Label}" Foreground="{StaticResource Overlay.Text}" />
                    <TextBlock Text="{Binding Summary}"
                               Margin="6,0,0,0"
                               FontFamily="{StaticResource Overlay.MonoFont}"
                               FontSize="11"
                               VerticalAlignment="Center"
                               Foreground="{StaticResource Overlay.TextMuted}" />
                </StackPanel>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Severity}" Value="Warning">
                    <Setter TargetName="Dot" Property="Fill" Value="{StaticResource Overlay.Warning}" />
                    <Setter TargetName="Chrome" Property="Background" Value="{StaticResource WarningSurface}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Severity}" Value="Error">
                    <Setter TargetName="Dot" Property="Fill" Value="{StaticResource Overlay.Danger}" />
                    <Setter TargetName="Chrome" Property="Background" Value="{StaticResource DangerSurface}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <DataTemplate x:Key="AlertCard">
            <Border Background="{StaticResource Overlay.Surface}" CornerRadius="8" Padding="12,8" Margin="0,6,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid Grid.Column="0" Width="18" Height="18" Margin="0,0,12,0" VerticalAlignment="Center">
                        <Ellipse Fill="{StaticResource Overlay.Danger}" />
                        <TextBlock Text="&#xE711;"
                                   FontFamily="{StaticResource Overlay.IconFont}"
                                   FontSize="9"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource Overlay.SurfaceSolid}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Grid>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Foreground="{StaticResource Overlay.Text}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding Detail}" FontSize="11" Foreground="{StaticResource Overlay.Text}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <TextBlock Grid.Column="2"
                               Text="{Binding AgeText}"
                               FontSize="10.5"
                               Margin="12,1,0,0"
                               VerticalAlignment="Top"
                               Foreground="{StaticResource Overlay.TextMuted}" />
                </Grid>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <!-- Everything is aligned to the top right corner and sized by its content, so the rest of the screen stays free. -->
    <StackPanel HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,12,16,0" Width="390">
        <Border HorizontalAlignment="Right" CornerRadius="14" Padding="10,5,6,5" Background="{StaticResource Overlay.Surface}">
            <StackPanel Orientation="Horizontal">
                <Image Source="/Assets/meerkat-app.ico"
                       Width="16"
                       Height="16"
                       Margin="0,0,6,0"
                       RenderOptions.BitmapScalingMode="HighQuality" />
                <ItemsControl ItemsSource="{Binding Chips}" ItemTemplate="{StaticResource Chip}" Focusable="False">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </StackPanel>
        </Border>

        <ItemsControl ItemsSource="{Binding Alerts}" ItemTemplate="{StaticResource AlertCard}" Focusable="False" />

        <Border Background="{StaticResource Overlay.Surface}" CornerRadius="8" Padding="12,7" Margin="0,6,0,0">
            <Border.Style>
                <Style TargetType="Border">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding MoreHintsCount}" Value="{x:Null}">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding MoreHintsCount}"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource Overlay.Warning}"
                           Width="30" />
                <TextBlock Text="{Binding MoreHintsText}" Foreground="{StaticResource Overlay.Text}" />
            </StackPanel>
        </Border>

        <Border HorizontalAlignment="Right"
                Background="{StaticResource Overlay.Surface}"
                CornerRadius="8"
                Padding="10,4"
                Margin="0,6,0,0"
                Visibility="{Binding HasAlerts, Converter={StaticResource BoolToVisibility}}">
            <TextBlock Text="{Binding DetailsHint}" FontSize="10.5" Foreground="{StaticResource Overlay.Text}" />
        </Border>

        <Border HorizontalAlignment="Right" Background="{StaticResource Overlay.Surface}" CornerRadius="8" Padding="10,4" Margin="0,6,0,0">
            <Border.Style>
                <Style TargetType="Border">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Notice}" Value="{x:Null}">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <StackPanel Orientation="Horizontal">
                <Ellipse Width="5" Height="5" Margin="0,1,6,0" Fill="{StaticResource Overlay.Accent}" />
                <TextBlock Text="{Binding Notice}" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource Overlay.Accent}" />
            </StackPanel>
        </Border>
    </StackPanel>
</Window>
