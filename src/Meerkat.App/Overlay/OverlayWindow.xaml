<Window x:Class="Meerkat.App.Overlay.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Meerkat"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        ResizeMode="NoResize"
        FontFamily="Segoe UI"
        FontSize="12">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <ControlTemplate x:Key="ResizeGrip" TargetType="Thumb">
            <Border Background="Transparent">
                <Path Data="M 12,2 L 12,12 L 2,12"
                      Stroke="{StaticResource Overlay.Accent}"
                      StrokeThickness="1.5"
                      HorizontalAlignment="Right"
                      VerticalAlignment="Bottom" />
            </Border>
        </ControlTemplate>

        <!-- Shown instead of the widget content when the widget threw; the shell itself keeps running. -->
        <DataTemplate x:Key="WidgetFailureTemplate">
            <StackPanel>
                <DockPanel>
                    <TextBlock DockPanel.Dock="Left"
                               Text="&#xEA39;"
                               FontFamily="{StaticResource Overlay.IconFont}"
                               FontSize="13"
                               Foreground="{StaticResource Overlay.Danger}"
                               VerticalAlignment="Center"
                               Margin="0,0,8,0" />
                    <TextBlock Text="Widget was suspended" FontWeight="SemiBold" FontSize="13" />
                </DockPanel>
                <TextBlock Text="An error in this widget was caught. The overlay and all other widgets keep running."
                           TextWrapping="Wrap"
                           Margin="21,4,0,0" />
                <Border Background="{StaticResource Overlay.SurfaceRaised}" CornerRadius="4" Padding="8,6" Margin="0,10,0,0">
                    <TextBlock Text="{Binding Detail}"
                               FontFamily="{StaticResource Overlay.MonoFont}"
                               FontSize="10.5"
                               Foreground="{StaticResource Overlay.TextMuted}"
                               TextWrapping="Wrap"
                               TextTrimming="CharacterEllipsis"
                               MaxHeight="58" />
                </Border>
                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                    <Button Content="Restart widget" Command="{Binding RestartCommand}" />
                    <Button Content="Open log" Margin="8,0,0,0" Command="{Binding OpenLogCommand}" />
                </StackPanel>
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="HostTemplate">
            <Border Width="{Binding Width}"
                    Height="{Binding Height}"
                    Background="{StaticResource Overlay.Surface}"
                    BorderBrush="{StaticResource Overlay.Border}"
                    BorderThickness="1"
                    CornerRadius="8"
                    TextElement.Foreground="{StaticResource Overlay.Text}">
                <Grid>
                    <DockPanel>
                        <!-- The whole header is the drag handle; buttons and text boxes inside swallow their own clicks. -->
                        <Border x:Name="Header"
                                DockPanel.Dock="Top"
                                Background="Transparent"
                                Padding="12,8,8,6"
                                MouseLeftButtonDown="OnHeaderMouseDown"
                                MouseMove="OnHeaderMouseMove"
                                MouseLeftButtonUp="OnHeaderMouseUp">
                            <DockPanel>
                                <Path DockPanel.Dock="Left"
                                      Data="M0,0h2v2h-2z M4,0h2v2h-2z M0,4h2v2h-2z M4,4h2v2h-2z M0,8h2v2h-2z M4,8h2v2h-2z"
                                      Fill="{StaticResource Overlay.TextMuted}"
                                      VerticalAlignment="Center"
                                      Margin="0,0,8,0"
                                      Visibility="{Binding IsInteractive, Converter={StaticResource BoolToVisibility}}" />
                                <TextBlock DockPanel.Dock="Left"
                                           Text="{Binding Title}"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center"
                                           Margin="0,0,10,0" />
                                <TextBlock x:Name="SuspendedLabel"
                                           DockPanel.Dock="Left"
                                           Text="suspended"
                                           Style="{StaticResource Overlay.Hint}" />
                                <ContentPresenter Content="{Binding HeaderContent}" VerticalAlignment="Center" />
                            </DockPanel>
                        </Border>
                        <Grid Margin="6,0,8,10">
                            <ContentPresenter x:Name="Body" Content="{Binding Content}" />
                            <ContentControl x:Name="FailureCard"
                                            Content="{Binding Failure}"
                                            ContentTemplate="{StaticResource WidgetFailureTemplate}"
                                            Margin="6,0,0,0"
                                            Focusable="False" />
                        </Grid>
                    </DockPanel>
                    <Thumb Template="{StaticResource ResizeGrip}"
                           Width="16"
                           Height="16"
                           Margin="0,0,3,3"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Bottom"
                           Cursor="SizeNWSE"
                           Visibility="{Binding IsInteractive, Converter={StaticResource BoolToVisibility}}"
                           DragDelta="OnResizeDelta"
                           DragCompleted="OnResizeCompleted" />
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Failure}" Value="{x:Null}">
                    <Setter TargetName="SuspendedLabel" Property="Visibility" Value="Collapsed" />
                    <!-- A content template is applied even to null content, so the card must be hidden explicitly. -->
                    <Setter TargetName="FailureCard" Property="Visibility" Value="Collapsed" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsInteractive}" Value="True">
                    <Setter TargetName="Header" Property="Cursor" Value="SizeAll" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <!-- Dimmed backdrop signals interactive mode and keeps stray clicks from reaching windows below. -->
        <Border Background="#40000000"
                Visibility="{Binding IsInteractive, Converter={StaticResource BoolToVisibility}}" />

        <ItemsControl ItemsSource="{Binding Hosts}" ItemTemplate="{StaticResource HostTemplate}" Focusable="False">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <Canvas />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemContainerStyle>
                <Style TargetType="ContentPresenter">
                    <Setter Property="Canvas.Left" Value="{Binding Left}" />
                    <Setter Property="Canvas.Top" Value="{Binding Top}" />
                </Style>
            </ItemsControl.ItemContainerStyle>
        </ItemsControl>

        <!-- Update card: only in interactive mode, where the user can actually respond to it. -->
        <Border DataContext="{Binding Update}"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Width="430"
                Padding="18,16"
                CornerRadius="10"
                Background="{StaticResource Overlay.SurfaceSolid}"
                BorderBrush="{StaticResource Overlay.Border}"
                BorderThickness="1"
                TextElement.Foreground="{StaticResource Overlay.Text}">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding DataContext.IsInteractive, RelativeSource={RelativeSource AncestorType=Window}}" Value="True" />
                                <Condition Binding="{Binding IsCardVisible}" Value="True" />
                            </MultiDataTrigger.Conditions>
                            <Setter Property="Visibility" Value="Visible" />
                        </MultiDataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <StackPanel>
                <DockPanel>
                    <Button DockPanel.Dock="Right"
                            Style="{StaticResource Overlay.IconButton}"
                            Content="&#xE8BB;"
                            ToolTip="Dismiss"
                            VerticalAlignment="Top"
                            Command="{Binding DismissCardCommand}" />
                    <Image DockPanel.Dock="Left"
                           Source="/Assets/meerkat-app.ico"
                           Width="34"
                           Height="34"
                           RenderOptions.BitmapScalingMode="HighQuality"
                           Margin="0,0,12,0" />
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding CardTitle}" FontSize="14" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding CardSubtitle}" Style="{StaticResource Overlay.Hint}" />
                    </StackPanel>
                </DockPanel>
                <ItemsControl ItemsSource="{Binding Highlights}" Margin="46,10,0,0" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock TextWrapping="Wrap" Margin="0,2">
                                <Run Text="•" />
                                <Run Text="{Binding Mode=OneWay}" />
                            </TextBlock>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <StackPanel Orientation="Horizontal" Margin="46,14,0,0">
                    <Button Style="{StaticResource Overlay.PrimaryButton}"
                            Content="Restart and install"
                            Command="{Binding RestartAndInstallCommand}" />
                    <Button Content="On exit" Margin="8,0,0,0" Command="{Binding InstallOnExitCommand}" />
                </StackPanel>
            </StackPanel>
        </Border>

        <Border HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Margin="0,10,0,0"
                Padding="12,3"
                CornerRadius="11"
                Background="{StaticResource Overlay.Accent}"
                Visibility="{Binding IsInteractive, Converter={StaticResource BoolToVisibility}}">
            <TextBlock Foreground="{StaticResource Overlay.OnAccent}" FontSize="11">
                <Run Text="Interactive mode" FontWeight="SemiBold" />
                <Run Text=" " />
                <Run Text="{Binding ModeHotkeyText, Mode=OneWay}" />
                <Run Text="returns to display mode" />
            </TextBlock>
        </Border>
    </Grid>
</Window>
