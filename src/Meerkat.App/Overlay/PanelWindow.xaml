<Window x:Class="Meerkat.App.Overlay.PanelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Meerkat panel"
        WindowStyle="None"
        ResizeMode="NoResize"
        Topmost="True"
        ShowInTaskbar="False"
        AllowsTransparency="True"
        Background="Transparent"
        Foreground="{StaticResource Overlay.Text}"
        FontFamily="Segoe UI"
        FontSize="12">
    <!-- The window itself is transparent so that the panel can slide in from the screen edge like a drawer. -->
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

        <!-- Shown instead of the widget content when the widget threw; the shell itself keeps running. -->
        <DataTemplate x:Key="WidgetFailureTemplate">
            <StackPanel>
                <DockPanel>
                    <TextBlock DockPanel.Dock="Left"
                               Text="&#xEA39;"
                               FontFamily="{StaticResource Overlay.IconFont}"
                               FontSize="13"
                               Foreground="{StaticResource Overlay.Danger}"
                               VerticalAlignment="Center"
                               Margin="0,0,8,0" />
                    <TextBlock Text="Widget was suspended" FontWeight="SemiBold" FontSize="13" />
                </DockPanel>
                <TextBlock Text="An error in this widget was caught. Meerkat and all other widgets keep running."
                           TextWrapping="Wrap"
                           Margin="21,4,0,0" />
                <Border Background="{StaticResource Overlay.SurfaceRaised}" CornerRadius="4" Padding="8,6" Margin="0,10,0,0">
                    <TextBlock Text="{Binding Detail}"
                               FontFamily="{StaticResource Overlay.MonoFont}"
                               FontSize="10.5"
                               Foreground="{StaticResource Overlay.TextMuted}"
                               TextWrapping="Wrap"
                               TextTrimming="CharacterEllipsis"
                               MaxHeight="58" />
                </Border>
                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                    <Button Content="Restart widget" Command="{Binding RestartCommand}" />
                    <Button Content="Open log" Margin="8,0,0,0" Command="{Binding OpenLogCommand}" />
                </StackPanel>
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="RailEntry">
            <Button Command="{Binding DataContext.SelectCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                    CommandParameter="{Binding}"
                    AutomationProperties.Name="{Binding Title}"
                    Cursor="Hand"
                    Focusable="False">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" Background="Transparent" CornerRadius="6" Padding="0,9" Margin="0,0,0,4">
                            <Grid>
                                <StackPanel>
                                    <TextBlock Text="{Binding Icon}"
                                               FontFamily="{StaticResource Overlay.IconFont}"
                                               FontSize="15"
                                               HorizontalAlignment="Center"
                                               Foreground="{StaticResource Overlay.Text}" />
                                    <TextBlock Text="{Binding Title}"
                                               FontSize="10.5"
                                               Margin="0,5,0,0"
                                               HorizontalAlignment="Center"
                                               Foreground="{StaticResource Overlay.Text}" />
                                </StackPanel>
                                <Ellipse x:Name="Badge"
                                         Width="7"
                                         Height="7"
                                         HorizontalAlignment="Right"
                                         VerticalAlignment="Top"
                                         Margin="0,-3,14,0"
                                         Fill="{StaticResource Overlay.Warning}"
                                         Visibility="Collapsed" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{StaticResource Overlay.Hover}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Badge}" Value="Warning">
                                <Setter TargetName="Badge" Property="Visibility" Value="Visible" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Badge}" Value="Error">
                                <Setter TargetName="Badge" Property="Visibility" Value="Visible" />
                                <Setter TargetName="Badge" Property="Fill" Value="{StaticResource Overlay.Danger}" />
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </DataTemplate>
    </Window.Resources>

    <Border x:Name="PanelRoot"
            Background="{StaticResource Overlay.SurfaceSolid}"
            BorderBrush="{StaticResource Overlay.Border}"
            BorderThickness="1,0,0,0">
        <Border.RenderTransform>
            <TranslateTransform x:Name="Slide" />
        </Border.RenderTransform>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="46" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" BorderBrush="{StaticResource Overlay.Border}" BorderThickness="0,0,0,1" Padding="16,0,8,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource Overlay.IconButton}"
                            Content="&#xE713;"
                            Padding="8,6"
                            FontSize="12"
                            ToolTip="Settings"
                            Command="{Binding OpenSettingsCommand}" />
                    <Button Style="{StaticResource Overlay.IconButton}"
                            Content="&#xE8BB;"
                            Padding="8,6"
                            FontSize="12"
                            ToolTip="Close panel"
                            Command="{Binding CloseCommand}" />
                </StackPanel>
                <Image Source="/Assets/meerkat-app.ico"
                       Width="20"
                       Height="20"
                       Margin="0,0,10,0"
                       RenderOptions.BitmapScalingMode="HighQuality" />
                <TextBlock Text="Meerkat" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
                <TextBlock Text="{Binding AttentionText}" Style="{StaticResource Overlay.Hint}" Margin="12,1,0,0" />
            </DockPanel>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="84" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" BorderBrush="{StaticResource Overlay.Border}" BorderThickness="0,0,1,0" Padding="8,10,8,0">
                <ItemsControl ItemsSource="{Binding Widgets}" ItemTemplate="{StaticResource RailEntry}" Focusable="False" />
            </Border>

            <DockPanel Grid.Column="1" Margin="18,14,18,16">
                <!-- Update card: the panel is where the user can act on it. -->
                <Border DockPanel.Dock="Top"
                        DataContext="{Binding Update}"
                        Margin="0,0,0,14"
                        Padding="14,12"
                        CornerRadius="8"
                        BorderThickness="1"
                        BorderBrush="{StaticResource Overlay.Border}"
                        Background="{StaticResource Overlay.SurfaceRaised}"
                        Visibility="{Binding IsCardVisible, Converter={StaticResource BoolToVisibility}, FallbackValue=Collapsed}">
                    <DockPanel>
                        <Button DockPanel.Dock="Right"
                                Style="{StaticResource Overlay.IconButton}"
                                Content="&#xE8BB;"
                                ToolTip="Dismiss"
                                VerticalAlignment="Top"
                                Command="{Binding DismissCardCommand}" />
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,8,0">
                            <Button Style="{StaticResource Overlay.PrimaryButton}"
                                    Content="Restart and install"
                                    Command="{Binding RestartAndInstallCommand}" />
                            <Button Content="On exit" Margin="8,0,0,0" Command="{Binding InstallOnExitCommand}" />
                        </StackPanel>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding CardTitle}" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding CardSubtitle}" Style="{StaticResource Overlay.Hint}" />
                        </StackPanel>
                    </DockPanel>
                </Border>

                <ContentPresenter DockPanel.Dock="Top" Content="{Binding SelectedWidget.HeaderContent}" Margin="0,0,0,10" />

                <Grid>
                    <ContentPresenter Content="{Binding SelectedWidget.Content}" />
                    <ContentControl Content="{Binding SelectedWidget.Failure}"
                                    ContentTemplate="{StaticResource WidgetFailureTemplate}"
                                    Focusable="False">
                        <ContentControl.Style>
                            <!-- A content template is applied even to null content, so the card must be hidden explicitly. -->
                            <Style TargetType="ContentControl">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedWidget.Failure}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ContentControl.Style>
                    </ContentControl>
                </Grid>
            </DockPanel>
        </Grid>

        <!-- The left edge is the only free one of a docked panel; dragging it changes the width. -->
        <Thumb Grid.RowSpan="2"
               Width="7"
               HorizontalAlignment="Left"
               Cursor="SizeWE"
               ToolTip="Drag to resize, double-click to reset"
               DragStarted="OnResizeStarted"
               DragDelta="OnResizeDelta"
               DragCompleted="OnResizeCompleted"
               MouseDoubleClick="OnResizeReset">
            <Thumb.Template>
                <ControlTemplate TargetType="Thumb">
                    <Border Background="Transparent">
                        <Border x:Name="Line" Width="2" HorizontalAlignment="Left" Background="Transparent" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Line" Property="Background" Value="{StaticResource Overlay.Accent}" />
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="Line" Property="Background" Value="{StaticResource Overlay.Accent}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Thumb.Template>
        </Thumb>
    </Grid>
    </Border>
</Window>
