<UserControl x:Class="Meerkat.App.SettingsUi.MachinesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <Style x:Key="LinkButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{StaticResource Overlay.Accent}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <TextBlock Text="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}" TextDecorations="Underline" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Overlay.TextMuted}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>
        <Style x:Key="ChoiceRadio" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource Overlay.Text}" />
            <Setter Property="Margin" Value="0,0,16,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <StackPanel Orientation="Horizontal" Background="Transparent">
                            <Grid Width="14" Height="14" VerticalAlignment="Center">
                                <Ellipse x:Name="Ring" Stroke="{StaticResource Overlay.TextMuted}" StrokeThickness="1" Fill="Transparent" />
                                <Ellipse x:Name="Dot" Width="6" Height="6" Fill="{StaticResource Overlay.Accent}" Visibility="Collapsed" />
                            </Grid>
                            <ContentPresenter Margin="7,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Ring" Property="Stroke" Value="{StaticResource Overlay.Accent}" />
                                <Setter TargetName="Dot" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <StackPanel>
        <DockPanel Margin="0,0,0,4">
            <Button DockPanel.Dock="Right" Content="+ Machine" Command="{Binding AddMachineCommand}" />
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Style="{StaticResource Overlay.ColumnHeader}" FontSize="10.5" Text="OTHER MACHINES (SSH)" VerticalAlignment="Center" />
                <ContentControl Style="{StaticResource Overlay.Info}" ToolTip="{Binding MachinesInfo}" />
            </StackPanel>
        </DockPanel>

        <ItemsControl ItemsSource="{Binding Machines}" Focusable="False">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border BorderBrush="{StaticResource Overlay.Border}" BorderThickness="0,0,0,1" Padding="0,7">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Style="{StaticResource LinkButton}" Content="Edit" VerticalAlignment="Center"
                                    Command="{Binding DataContext.EditMachineCommand, ElementName=Root}" CommandParameter="{Binding}" />
                            <StackPanel Margin="0,0,10,0">
                                <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding Destination}" FontFamily="{StaticResource Overlay.MonoFont}" FontSize="10.5" TextTrimming="CharacterEllipsis"
                                           Foreground="{StaticResource Overlay.TextMuted}" />
                            </StackPanel>
                        </DockPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        <TextBlock Text="No machines yet." Margin="0,2,0,0">
            <TextBlock.Style>
                <Style TargetType="TextBlock" BasedOn="{StaticResource Overlay.Hint}">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HasMachines}" Value="False">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>

        <Border Margin="0,12,0,0"
                Padding="14,12"
                CornerRadius="6"
                BorderThickness="1"
                BorderBrush="{StaticResource Overlay.Border}"
                Background="{StaticResource Overlay.SurfaceRaised}"
                Visibility="{Binding IsFormOpen, Converter={StaticResource BoolToVisibility}}">
            <StackPanel>
                <TextBlock Text="{Binding FormTitle}" FontWeight="SemiBold" FontSize="13" />

                <StackPanel Orientation="Horizontal" Margin="0,8,0,0" Visibility="{Binding HasConfigHosts, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Margin="0,0,12,0" VerticalAlignment="Center">
                        <Run Text="From" />
                        <Run Text="~/.ssh/config:" FontFamily="{StaticResource Overlay.MonoFont}" FontSize="11" />
                    </TextBlock>
                    <ListBox ItemsSource="{Binding ConfigHosts}"
                             SelectedItem="{Binding SelectedConfigHost}"
                             Background="Transparent"
                             BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <RadioButton Style="{StaticResource ChoiceRadio}"
                                                         Content="{Binding DisplayName}"
                                                         IsChecked="{Binding IsSelected, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" />
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                    </ListBox>
                </StackPanel>

                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="110" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="60" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Style="{StaticResource FieldLabel}" Text="Name" />
                        <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Style="{StaticResource FieldLabel}" Text="Host name or alias" />
                        <TextBox Text="{Binding Hostname, UpdateSourceTrigger=PropertyChanged}" FontFamily="{StaticResource Overlay.MonoFont}" />
                    </StackPanel>
                    <StackPanel Grid.Column="4">
                        <TextBlock Style="{StaticResource FieldLabel}" Text="User" />
                        <TextBox Text="{Binding User, UpdateSourceTrigger=PropertyChanged}" FontFamily="{StaticResource Overlay.MonoFont}" />
                    </StackPanel>
                    <StackPanel Grid.Column="6">
                        <TextBlock Style="{StaticResource FieldLabel}" Text="Port" />
                        <TextBox Text="{Binding Port, UpdateSourceTrigger=PropertyChanged}" FontFamily="{StaticResource Overlay.MonoFont}" />
                    </StackPanel>
                </Grid>

                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                    <TextBlock Text="Sign in with" VerticalAlignment="Center" />
                    <ContentControl Style="{StaticResource Overlay.Info}" ToolTip="{Binding SignInInfo}" Margin="6,1,14,0" />
                    <RadioButton Style="{StaticResource ChoiceRadio}" Content="SSH agent" GroupName="MachineAuthentication" IsChecked="{Binding UsesAgent}" />
                    <RadioButton Style="{StaticResource ChoiceRadio}" Content="Key file" GroupName="MachineAuthentication" IsChecked="{Binding UsesKeyFile}" />
                    <RadioButton Style="{StaticResource ChoiceRadio}" Content="Password" GroupName="MachineAuthentication" IsChecked="{Binding UsesPassword}" />
                </StackPanel>

                <!-- Each sign-in method shows only what it needs. -->
                <StackPanel Margin="0,8,0,0" Visibility="{Binding UsesKeyFile, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Style="{StaticResource FieldLabel}" Text="Private key file" />
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="Browse …" Margin="8,0,0,0" Click="OnBrowseKeyFile" />
                        <TextBox Text="{Binding KeyFile, UpdateSourceTrigger=PropertyChanged}" FontFamily="{StaticResource Overlay.MonoFont}" />
                    </DockPanel>
                </StackPanel>

                <StackPanel Margin="0,8,0,0" Visibility="{Binding UsesPassword, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Style="{StaticResource FieldLabel}" Text="Password for the user above" />
                    <Grid Width="260" HorizontalAlignment="Left">
                        <PasswordBox x:Name="PasswordInput" PasswordChanged="OnPasswordChanged" />
                        <!-- The stored password is never loaded into the page; dots show that there is one. -->
                        <TextBlock Text="••••••••••••"
                                   Margin="8,0,0,0"
                                   VerticalAlignment="Center"
                                   IsHitTestVisible="False"
                                   Foreground="{StaticResource Overlay.TextMuted}"
                                   Visibility="{Binding ShowStoredPasswordPlaceholder, Converter={StaticResource BoolToVisibility}}" />
                    </Grid>
                </StackPanel>

                <TextBlock Text="{Binding FormStatus}" TextWrapping="Wrap" FontSize="11" Margin="0,10,0,0">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{StaticResource Overlay.Text}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsFormError}" Value="True">
                                    <Setter Property="Foreground" Value="{StaticResource Overlay.Danger}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding FormStatus}" Value="">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <DockPanel Margin="0,12,0,0">
                    <Button DockPanel.Dock="Right" Content="Remove" Foreground="{StaticResource Overlay.Danger}" Command="{Binding RemoveMachineCommand}"
                            ToolTip="Removes the machine from Meerkat, for every widget that uses it."
                            Visibility="{Binding IsEditing, Converter={StaticResource BoolToVisibility}}" />
                    <StackPanel Orientation="Horizontal">
                        <Button Style="{StaticResource Overlay.PrimaryButton}" Content="Connect and check" Command="{Binding ConnectAndCheckCommand}" ToolTip="{Binding CheckInfo}" />
                        <Button Content="Save without checking"
                                Margin="8,0,0,0"
                                Command="{Binding SaveUncheckedCommand}"
                                Visibility="{Binding CanSaveUnchecked, Converter={StaticResource BoolToVisibility}}" />
                        <Button Content="Cancel" Margin="8,0,0,0" Command="{Binding CancelFormCommand}" />
                    </StackPanel>
                </DockPanel>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
