<Window x:Class="Meerkat.App.SettingsUi.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Meerkat – Settings"
        Icon="/Assets/meerkat-app.ico"
        Width="660"
        Height="690"
        WindowStyle="None"
        ResizeMode="NoResize"
        Topmost="True"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Overlay.SurfaceSolid}"
        Foreground="{StaticResource Overlay.Text}"
        BorderBrush="{StaticResource Overlay.Border}"
        BorderThickness="1"
        FontFamily="Segoe UI"
        FontSize="12">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="36" GlassFrameThickness="0" CornerRadius="0" ResizeBorderThickness="0" />
    </WindowChrome.WindowChrome>
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <Style x:Key="NavigationItem" TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{StaticResource Overlay.Text}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Chrome" Background="Transparent" CornerRadius="4" Padding="10,6" Margin="0,1">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{StaticResource Overlay.SurfaceRaised}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{StaticResource Overlay.Hover}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="36" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Title bar -->
        <Border Grid.Row="0" BorderBrush="{StaticResource Overlay.Border}" BorderThickness="0,0,0,1">
            <DockPanel>
                <Button DockPanel.Dock="Right"
                        Style="{StaticResource Overlay.IconButton}"
                        Content="&#xE8BB;"
                        Width="36"
                        WindowChrome.IsHitTestVisibleInChrome="True"
                        Click="OnCancelClick" />
                <Image Source="/Assets/meerkat-app.ico"
                       Width="18"
                       Height="18"
                       RenderOptions.BitmapScalingMode="HighQuality"
                       VerticalAlignment="Center"
                       Margin="12,0,8,0" />
                <TextBlock Text="Meerkat – Settings" FontWeight="SemiBold" VerticalAlignment="Center" />
            </DockPanel>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="150" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <ListBox x:Name="Navigation"
                     Grid.Column="0"
                     ItemsSource="{Binding NavigationItems}"
                     ItemContainerStyle="{StaticResource NavigationItem}"
                     Background="Transparent"
                     BorderThickness="0"
                     Margin="10,14,6,0"
                     SelectedIndex="0"
                     SelectionChanged="OnNavigationSelectionChanged" />

            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" Focusable="False">
                <StackPanel Margin="14,16,20,16">

                    <StackPanel x:Name="HotkeysSection">
                        <TextBlock Style="{StaticResource Overlay.SectionTitle}" Text="Hotkeys" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="162" />
                                <ColumnDefinition Width="142" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource Overlay.FormLabel}" Text="Toggle mode" />
                            <TextBox Grid.Row="0" Grid.Column="1" Margin="0,5"
                                     IsReadOnly="True"
                                     FontFamily="{StaticResource Overlay.MonoFont}"
                                     ToolTip="Click the field and press the desired key combination"
                                     Text="{Binding ToggleModeHotkey, UpdateSourceTrigger=PropertyChanged}"
                                     PreviewKeyDown="OnHotkeyBoxKeyDown" />
                            <TextBlock Grid.Row="0" Grid.Column="2" Style="{StaticResource Overlay.Hint}" Margin="10,0,0,0" Text="Display ↔ interactive" />

                            <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource Overlay.FormLabel}" Text="Show/hide overlay" />
                            <TextBox Grid.Row="1" Grid.Column="1" Margin="0,5"
                                     IsReadOnly="True"
                                     FontFamily="{StaticResource Overlay.MonoFont}"
                                     ToolTip="Click the field and press the desired key combination"
                                     Text="{Binding ToggleVisibilityHotkey, UpdateSourceTrigger=PropertyChanged}"
                                     PreviewKeyDown="OnHotkeyBoxKeyDown" />
                            <TextBlock Grid.Row="1" Grid.Column="2" Style="{StaticResource Overlay.Hint}" Margin="10,0,0,0" Text="No polling while hidden" />
                        </Grid>
                        <DockPanel Margin="0,4,0,0">
                            <DockPanel.Style>
                                <Style TargetType="DockPanel">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HotkeyWarning}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DockPanel.Style>
                            <TextBlock DockPanel.Dock="Left"
                                       Text="&#xE7BA;"
                                       FontFamily="{StaticResource Overlay.IconFont}"
                                       Foreground="{StaticResource Overlay.Warning}"
                                       VerticalAlignment="Center"
                                       Margin="0,0,8,0" />
                            <TextBlock Text="{Binding HotkeyWarning}" Foreground="{StaticResource Overlay.Warning}" TextWrapping="Wrap" />
                        </DockPanel>
                    </StackPanel>

                    <StackPanel x:Name="AppearanceSection" Margin="0,22,0,0">
                        <TextBlock Style="{StaticResource Overlay.SectionTitle}" Text="Appearance" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="162" />
                                <ColumnDefinition Width="142" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource Overlay.FormLabel}" Text="Opacity" />
                            <Slider Grid.Row="0" Grid.Column="1" Margin="0,8"
                                    Minimum="0.2" Maximum="1" LargeChange="0.1" SmallChange="0.01"
                                    Value="{Binding Opacity}" />
                            <TextBlock Grid.Row="0" Grid.Column="2" Margin="10,0,0,0" VerticalAlignment="Center"
                                       FontFamily="{StaticResource Overlay.MonoFont}" Text="{Binding OpacityText}" />

                            <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource Overlay.FormLabel}" Text="Monitor" />
                            <ComboBox Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,5" Width="230" HorizontalAlignment="Left"
                                      ItemsSource="{Binding Monitors}"
                                      SelectedItem="{Binding SelectedMonitor}"
                                      DisplayMemberPath="DisplayName" />
                        </Grid>
                        <TextBlock Style="{StaticResource Overlay.Hint}" Margin="162,2,0,0" Text="Positions are stored per monitor" />
                    </StackPanel>

                    <StackPanel x:Name="WidgetsSection" Margin="0,22,0,0">
                        <TextBlock Style="{StaticResource Overlay.SectionTitle}" Text="Widgets" />
                        <ItemsControl ItemsSource="{Binding Widgets}" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{StaticResource Overlay.Border}" BorderThickness="1" CornerRadius="4" Padding="12,8" Margin="0,0,0,6">
                                        <DockPanel>
                                            <Button DockPanel.Dock="Right" Command="{Binding ResetPositionCommand}">
                                                <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource Overlay.Button}">
                                                        <Setter Property="Content" Value="Reset position" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsResetPending}" Value="True">
                                                                <Setter Property="Content" Value="Will be reset on save" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                            <CheckBox IsChecked="{Binding IsEnabled}" VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                                                    <TextBlock Text="{Binding TypeName}"
                                                               Style="{StaticResource Overlay.Hint}"
                                                               FontFamily="{StaticResource Overlay.MonoFont}"
                                                               Margin="10,0,0,0" />
                                                </StackPanel>
                                            </CheckBox>
                                        </DockPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <ItemsControl x:Name="WidgetSections" ItemsSource="{Binding WidgetSections}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,16,0,0">
                                    <TextBlock Style="{StaticResource Overlay.SectionTitle}" Text="{Binding Title}" />
                                    <ContentPresenter Content="{Binding View}" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- Footer -->
        <Border Grid.Row="2" BorderBrush="{StaticResource Overlay.Border}" BorderThickness="0,1,0,0" Padding="16,12">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="Cancel" MinWidth="88" IsCancel="True" Click="OnCancelClick" />
                    <Button Content="Save" MinWidth="88" Margin="8,0,0,0" Style="{StaticResource Overlay.PrimaryButton}" Click="OnSaveClick" />
                </StackPanel>
                <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                    <TextBlock Style="{StaticResource Overlay.Hint}"
                               FontFamily="{StaticResource Overlay.MonoFont}"
                               FontSize="10"
                               Text="{Binding SettingsFilePath}" />
                    <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource Overlay.Danger}" TextWrapping="Wrap">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ErrorMessage}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</Window>
