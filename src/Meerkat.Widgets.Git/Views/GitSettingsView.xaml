<UserControl x:Class="Meerkat.Widgets.Git.Views.GitSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <Style x:Key="LinkButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{DynamicResource Overlay.Accent}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <TextBlock Text="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}" TextDecorations="Underline" FontSize="11" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="24" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0">
            <TextBlock Style="{DynamicResource Overlay.FormLabel}" Text="Provider" />
            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                <RadioButton Style="{DynamicResource Overlay.Chip}" Content="GitLab" GroupName="GitProvider" IsChecked="{Binding IsGitLab}" />
                <RadioButton Style="{DynamicResource Overlay.Chip}" Content="GitHub" GroupName="GitProvider" IsChecked="{Binding IsGitHub}" Margin="4,0,0,0" />
            </StackPanel>

            <TextBlock Style="{DynamicResource Overlay.FormLabel}" Text="{Binding TokenLabel}" TextWrapping="Wrap" Margin="0,14,0,0" />
            <DockPanel Margin="0,6,0,0">
                <Button DockPanel.Dock="Right" Content="Test connection" Margin="8,0,0,0" Command="{Binding TestConnectionCommand}" />
                <Grid>
                    <PasswordBox x:Name="TokenBox" PasswordChanged="OnTokenChanged" />
                    <!-- The stored token is never loaded into the page; dots show that there is one. -->
                    <TextBlock Text="••••••••••••••••••••"
                               Margin="8,0,0,0"
                               VerticalAlignment="Center"
                               IsHitTestVisible="False"
                               Foreground="{DynamicResource Overlay.TextMuted}"
                               Visibility="{Binding ShowStoredTokenPlaceholder, Converter={StaticResource BoolToVisibility}}" />
                </Grid>
            </DockPanel>

            <DockPanel Margin="0,8,0,0">
                <Ellipse DockPanel.Dock="Left" Width="7" Height="7" Margin="0,4,7,0" VerticalAlignment="Top">
                    <Ellipse.Style>
                        <Style TargetType="Ellipse">
                            <Setter Property="Fill" Value="{DynamicResource Overlay.TextMuted}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ConnectionState}" Value="Connected">
                                    <Setter Property="Fill" Value="{DynamicResource Overlay.Success}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding ConnectionState}" Value="Failed">
                                    <Setter Property="Fill" Value="{DynamicResource Overlay.Danger}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding ConnectionStatus}" Value="">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Ellipse.Style>
                </Ellipse>
                <TextBlock TextWrapping="Wrap" FontSize="11" Text="{Binding ConnectionStatus}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{DynamicResource Overlay.Text}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ConnectionState}" Value="Failed">
                                    <Setter Property="Foreground" Value="{DynamicResource Overlay.Danger}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding ConnectionStatus}" Value="">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </DockPanel>

            <TextBlock Style="{DynamicResource Overlay.Hint}"
                       TextWrapping="Wrap"
                       TextTrimming="None"
                       Margin="0,6,0,0"
                       Text="Stored in the Windows Credential Manager, not in the JSON file. Type a new token to replace the stored one." />
            <Button Style="{StaticResource LinkButton}"
                    Content="Remove stored token"
                    HorizontalAlignment="Left"
                    Margin="0,4,0,0"
                    Command="{Binding RemoveTokenCommand}"
                    Visibility="{Binding HasStoredToken, Converter={StaticResource BoolToVisibility}}" />

            <CheckBox Margin="0,14,0,0" Content="{Binding OnlyMineLabel}" IsChecked="{Binding OnlyMyBranches}" />
        </StackPanel>

        <StackPanel Grid.Column="2">
            <TextBlock Style="{DynamicResource Overlay.FormLabel}" Text="Server URL" />
            <TextBox Margin="0,6,0,0" Text="{Binding ServerUrl, UpdateSourceTrigger=PropertyChanged}" />

            <TextBlock Style="{DynamicResource Overlay.FormLabel}" Text="{Binding ProjectsSummary}" Margin="0,14,0,0" />
            <Grid Margin="0,6,0,0">
                <TextBox Text="{Binding ProjectFilter, UpdateSourceTrigger=PropertyChanged}" Padding="6,3" />
                <TextBlock Text="Search …" Margin="9,0,0,0" IsHitTestVisible="False">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource Overlay.Hint}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ProjectFilter}" Value="">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
            <Border Height="104"
                    Margin="0,4,0,0"
                    Padding="8,4"
                    CornerRadius="4"
                    BorderThickness="1"
                    BorderBrush="{DynamicResource Overlay.Border}">
                <Grid>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
                        <ItemsControl ItemsSource="{Binding Projects}" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox Margin="0,4"
                                              Content="{Binding Project.Name}"
                                              IsChecked="{Binding IsSelected}"
                                              Visibility="{Binding IsVisible, Converter={StaticResource BoolToVisibility}}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <TextBlock TextWrapping="Wrap" TextTrimming="None" VerticalAlignment="Center" Text="Enter a token and test the connection to load the list.">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource Overlay.Hint}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Projects.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </Border>

            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                <TextBlock Style="{DynamicResource Overlay.FormLabel}" Text="Interval" Margin="0,0,12,0" />
                <TextBox Width="70" FontFamily="{DynamicResource Overlay.MonoFont}" Text="{Binding IntervalSeconds}" />
                <TextBlock Style="{DynamicResource Overlay.Hint}" Text="seconds" Margin="8,0,0,0" />
            </StackPanel>
        </StackPanel>
    </Grid>
</UserControl>
