<UserControl x:Class="Meerkat.Widgets.Git.Views.GitHeaderView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontSize="11">
    <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
            <!-- How old the shown data is. -->
            <TextBlock Style="{DynamicResource Overlay.Hint}" Text="{Binding AgeText}" Margin="0,0,8,0" VerticalAlignment="Center" />
            <Button Style="{DynamicResource Overlay.IconButton}"
                    Content="&#xE72C;"
                    ToolTip="Refresh now"
                    Command="{Binding RefreshCommand}" />
            <Button Style="{DynamicResource Overlay.IconButton}"
                    Content="&#xE713;"
                    ToolTip="Git settings"
                    Command="{Binding OpenSettingsCommand}" />
        </StackPanel>

        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <TextBlock Style="{DynamicResource Overlay.ColumnHeader}" FontSize="10.5" Text="GIT" />
            <TextBlock Style="{DynamicResource Overlay.Hint}" Text="{Binding ProviderSummary, StringFormat=' · {0}'}" />
        </StackPanel>
    </DockPanel>
</UserControl>
