<UserControl x:Class="Meerkat.Widgets.Git.Views.GitHeaderView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontSize="11">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </UserControl.Resources>
    <DockPanel>
        <!-- Display mode: how old the shown data is. -->
        <TextBlock DockPanel.Dock="Right"
                   Style="{DynamicResource Overlay.Hint}"
                   Text="{Binding AgeText}"
                   Visibility="{Binding IsDisplayMode, Converter={StaticResource BoolToVisibility}}" />

        <StackPanel DockPanel.Dock="Right"
                    Orientation="Horizontal"
                    Visibility="{Binding IsInteractive, Converter={StaticResource BoolToVisibility}}">
            <Button Style="{DynamicResource Overlay.IconButton}"
                    Content="&#xE72C;"
                    ToolTip="Refresh now"
                    Command="{Binding RefreshCommand}" />
            <Button Style="{DynamicResource Overlay.IconButton}"
                    Content="&#xE713;"
                    ToolTip="Settings"
                    Command="{Binding OpenSettingsCommand}" />
        </StackPanel>

        <Grid VerticalAlignment="Center">
            <TextBlock Style="{DynamicResource Overlay.Hint}"
                       Visibility="{Binding IsDisplayMode, Converter={StaticResource BoolToVisibility}}">
                <Run Text="{Binding Terminology.ProviderName, Mode=OneWay}" />
                <Run Text="·" />
                <Run Text="{Binding Terminology.PipelinesTitle, Mode=OneWay}" />
            </TextBlock>
            <TextBlock Style="{DynamicResource Overlay.Hint}"
                       Text="{Binding ProviderSummary}"
                       Visibility="{Binding IsInteractive, Converter={StaticResource BoolToVisibility}}" />
        </Grid>
    </DockPanel>
</UserControl>
