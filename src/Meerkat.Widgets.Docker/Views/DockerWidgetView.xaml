<UserControl x:Class="Meerkat.Widgets.Docker.Views.DockerWidgetView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root"
             Foreground="{DynamicResource Overlay.Text}"
             FontSize="12">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

        <Style x:Key="ValueText" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{DynamicResource Overlay.MonoFont}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="HorizontalAlignment" Value="Right" />
        </Style>
        <Style x:Key="SubValueText" TargetType="TextBlock" BasedOn="{StaticResource ValueText}">
            <Setter Property="FontSize" Value="9.5" />
            <Setter Property="Foreground" Value="{DynamicResource Overlay.TextMuted}" />
        </Style>

        <DataTemplate x:Key="FailureTemplate">
            <StackPanel Margin="8,4,4,0">
                <DockPanel>
                    <TextBlock x:Name="Icon"
                               DockPanel.Dock="Left"
                               Text="&#xEA39;"
                               FontFamily="{DynamicResource Overlay.IconFont}"
                               FontSize="13"
                               Foreground="{DynamicResource Overlay.Danger}"
                               VerticalAlignment="Center"
                               Margin="0,0,8,0" />
                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="13" />
                </DockPanel>
                <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Margin="21,4,0,0" />
                <Border Background="{DynamicResource Overlay.SurfaceRaised}" CornerRadius="4" Padding="8,6" Margin="0,10,0,0">
                    <TextBlock Text="{Binding Detail}"
                               FontFamily="{DynamicResource Overlay.MonoFont}"
                               FontSize="10.5"
                               Foreground="{DynamicResource Overlay.TextMuted}"
                               TextWrapping="Wrap"
                               TextTrimming="CharacterEllipsis"
                               MaxHeight="58" />
                </Border>
                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                    <Button Content="Retry" Command="{Binding DataContext.RefreshCommand, ElementName=Root}" />
                    <Button Content="Choose distribution"
                            Margin="8,0,0,0"
                            Command="{Binding DataContext.OpenSettingsCommand, ElementName=Root}"
                            Visibility="{Binding CanChooseDistribution, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>
            </StackPanel>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsWarning}" Value="True">
                    <Setter TargetName="Icon" Property="Text" Value="&#xE7BA;" />
                    <Setter TargetName="Icon" Property="Foreground" Value="{DynamicResource Overlay.Warning}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <DataTemplate x:Key="ContainerRowTemplate">
            <Border x:Name="RowChrome"
                    Padding="6,5,4,5"
                    CornerRadius="4"
                    Background="Transparent"
                    BorderBrush="Transparent"
                    BorderThickness="2,0,0,0"
                    ToolTip="{Binding Status}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="78" />
                        <ColumnDefinition Width="62" />
                        <ColumnDefinition Width="74" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,10,0">
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding Image}"
                                   FontFamily="{DynamicResource Overlay.MonoFont}"
                                   FontSize="9.5"
                                   Foreground="{DynamicResource Overlay.TextMuted}"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse x:Name="StatusDot"
                                 Width="6"
                                 Height="6"
                                 Margin="0,1,6,0"
                                 Fill="{DynamicResource Overlay.TextMuted}" />
                        <TextBlock x:Name="StatusLabel"
                                   Text="{Binding StatusText}"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource Overlay.TextMuted}" />
                    </StackPanel>

                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource ValueText}" Text="{Binding CpuText}" />
                        <ProgressBar Style="{DynamicResource Overlay.Meter}"
                                     Margin="14,4,0,0"
                                     Maximum="100"
                                     Value="{Binding CpuPercent, Mode=OneWay}" />
                    </StackPanel>

                    <StackPanel Grid.Column="3" VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource ValueText}" Text="{Binding MemoryText}" />
                        <TextBlock Style="{StaticResource SubValueText}" Text="{Binding MemoryPercentText}" />
                    </StackPanel>

                    <StackPanel Grid.Column="4"
                                Width="84"
                                Orientation="Horizontal"
                                FlowDirection="RightToLeft"
                                VerticalAlignment="Center"
                                Visibility="{Binding DataContext.IsInteractive, ElementName=Root, Converter={StaticResource BoolToVisibility}}">
                        <Button Style="{DynamicResource Overlay.IconButton}"
                                Content="&#xE72C;"
                                ToolTip="Restart"
                                Command="{Binding DataContext.RestartContainerCommand, ElementName=Root}"
                                CommandParameter="{Binding}" />
                        <Button Style="{DynamicResource Overlay.IconButton}"
                                Content="&#xE71A;"
                                ToolTip="Stop"
                                Visibility="{Binding IsRunning, Converter={StaticResource BoolToVisibility}}"
                                Command="{Binding DataContext.StopContainerCommand, ElementName=Root}"
                                CommandParameter="{Binding}" />
                        <Button Style="{DynamicResource Overlay.IconButton}"
                                Content="&#xE768;"
                                ToolTip="Start"
                                Visibility="{Binding IsStopped, Converter={StaticResource BoolToVisibility}}"
                                Command="{Binding DataContext.StartContainerCommand, ElementName=Root}"
                                CommandParameter="{Binding}" />
                        <Button Style="{DynamicResource Overlay.IconButton}"
                                Content="&#xE8FD;"
                                ToolTip="Show logs"
                                Command="{Binding DataContext.ShowLogsCommand, ElementName=Root}"
                                CommandParameter="{Binding}" />
                    </StackPanel>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding StatusKind}" Value="Running">
                    <Setter TargetName="StatusDot" Property="Fill" Value="{DynamicResource Overlay.Success}" />
                    <Setter TargetName="StatusLabel" Property="Foreground" Value="{DynamicResource Overlay.Success}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding StatusKind}" Value="Restarting">
                    <Setter TargetName="StatusDot" Property="Fill" Value="{DynamicResource Overlay.Warning}" />
                    <Setter TargetName="StatusLabel" Property="Foreground" Value="{DynamicResource Overlay.Warning}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding StatusKind}" Value="Paused">
                    <Setter TargetName="StatusDot" Property="Fill" Value="{DynamicResource Overlay.Warning}" />
                    <Setter TargetName="StatusLabel" Property="Foreground" Value="{DynamicResource Overlay.Warning}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsLogTarget}" Value="True">
                    <Setter TargetName="RowChrome" Property="Background" Value="{DynamicResource Overlay.Hover}" />
                    <Setter TargetName="RowChrome" Property="BorderBrush" Value="{DynamicResource Overlay.Accent}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <ContentControl Content="{Binding Failure}" ContentTemplate="{StaticResource FailureTemplate}" Focusable="False">
            <ContentControl.Style>
                <!-- A content template is applied even to null content, so the card must be hidden explicitly. -->
                <Style TargetType="ContentControl">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Failure}" Value="{x:Null}">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ContentControl.Style>
        </ContentControl>

        <DockPanel>
            <DockPanel.Style>
                <Style TargetType="DockPanel">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Failure}" Value="{x:Null}">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </DockPanel.Style>

            <!-- Footer: only in display mode, where it doubles as a hint on how to interact. -->
            <Grid DockPanel.Dock="Bottom"
                  Margin="8,6,4,0"
                  Visibility="{Binding IsDisplayMode, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Style="{DynamicResource Overlay.Hint}" FontSize="10" Text="{Binding IntervalText}" />
                <TextBlock x:Name="InteractHint" FontSize="10" HorizontalAlignment="Right">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource Overlay.Hint}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Notice}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                    <Run Text="Interact:" />
                    <Run Text="{Binding ModeHotkeyText, Mode=OneWay}"
                         FontFamily="{DynamicResource Overlay.MonoFont}"
                         Foreground="{DynamicResource Overlay.Text}" />
                </TextBlock>
                <!-- A notice from the shell takes the place of the hint; it must work without any interaction. -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Notice}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <Ellipse Width="5" Height="5" Margin="0,1,6,0" Fill="{DynamicResource Overlay.Accent}" />
                    <TextBlock Text="{Binding Notice}"
                               FontSize="10"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource Overlay.Accent}"
                               VerticalAlignment="Center" />
                </StackPanel>
            </Grid>

            <TextBlock DockPanel.Dock="Bottom"
                       Text="{Binding ErrorMessage}"
                       Foreground="{DynamicResource Overlay.Danger}"
                       FontSize="11"
                       TextWrapping="Wrap"
                       TextTrimming="CharacterEllipsis"
                       MaxHeight="34"
                       Margin="8,4,4,0">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ErrorMessage}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <Grid DockPanel.Dock="Top" Margin="8,2,4,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="78" />
                    <ColumnDefinition Width="62" />
                    <ColumnDefinition Width="74" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Style="{DynamicResource Overlay.ColumnHeader}" Text="CONTAINER" />
                <TextBlock Grid.Column="1" Style="{DynamicResource Overlay.ColumnHeader}" Text="STATUS" />
                <TextBlock Grid.Column="2" Style="{DynamicResource Overlay.ColumnHeader}" Text="CPU" HorizontalAlignment="Right" />
                <TextBlock Grid.Column="3" Style="{DynamicResource Overlay.ColumnHeader}" Text="RAM" HorizontalAlignment="Right" />
                <TextBlock Grid.Column="4"
                           Width="84"
                           Style="{DynamicResource Overlay.ColumnHeader}"
                           Text="ACTIONS"
                           TextAlignment="Right"
                           Visibility="{Binding IsInteractive, Converter={StaticResource BoolToVisibility}}" />
            </Grid>

            <Grid>
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                    <ItemsControl ItemsSource="{Binding Containers}"
                                  ItemTemplate="{StaticResource ContainerRowTemplate}"
                                  Focusable="False" />
                </ScrollViewer>
                <TextBlock Text="No containers"
                           Style="{DynamicResource Overlay.Hint}"
                           HorizontalAlignment="Center"
                           Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}" />
            </Grid>
        </DockPanel>
    </Grid>
</UserControl>
