<UserControl x:Class="Meerkat.Widgets.Docker.Views.LogPanelView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Foreground="{DynamicResource Overlay.Text}">
    <DockPanel>
        <Grid DockPanel.Dock="Bottom" Margin="0,6,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Style="{DynamicResource Overlay.Hint}" FontSize="10" Text="{Binding LineCountText}" />
            <TextBlock Grid.Column="1"
                       Style="{DynamicResource Overlay.Hint}"
                       FontSize="10"
                       FontFamily="{DynamicResource Overlay.MonoFont}"
                       Margin="12,0"
                       Text="{Binding CommandText}" />
            <TextBlock Grid.Column="2" FontSize="10">
                <TextBlock.Style>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource Overlay.Hint}">
                        <Setter Property="Text" Value="Following" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsFollowing}" Value="False">
                                <Setter Property="Text" Value="Not following – scroll to the end" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsPaused}" Value="True">
                                <Setter Property="Text" Value="Paused" />
                                <Setter Property="Foreground" Value="{DynamicResource Overlay.Warning}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </Grid>

        <ListBox ItemsSource="{Binding Lines}"
                 Background="Transparent"
                 BorderThickness="0"
                 Padding="0"
                 Foreground="{DynamicResource Overlay.Text}"
                 FontFamily="{DynamicResource Overlay.MonoFont}"
                 FontSize="11"
                 Focusable="False"
                 VirtualizingPanel.IsVirtualizing="True"
                 VirtualizingPanel.VirtualizationMode="Recycling"
                 ScrollViewer.CanContentScroll="True"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 ScrollViewer.ScrollChanged="OnScrollChanged">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Focusable" Value="False" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <ContentPresenter />
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border x:Name="LineChrome" Background="Transparent" Padding="4,1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding TimeText}" Foreground="{DynamicResource Overlay.TextMuted}" />
                            <TextBlock x:Name="StreamText"
                                       Grid.Column="1"
                                       Text="{Binding StreamLabel}"
                                       Margin="10,0"
                                       Foreground="{DynamicResource Overlay.TextMuted}" />
                            <TextBlock x:Name="LineText" Grid.Column="2" Text="{Binding Text}" TextTrimming="CharacterEllipsis" />
                        </Grid>
                    </Border>
                    <DataTemplate.Triggers>
                        <DataTrigger Binding="{Binding IsError}" Value="True">
                            <Setter TargetName="LineChrome" Property="Background" Value="{DynamicResource Overlay.WarningSurface}" />
                            <Setter TargetName="StreamText" Property="Foreground" Value="{DynamicResource Overlay.Warning}" />
                            <Setter TargetName="LineText" Property="Foreground" Value="{DynamicResource Overlay.Warning}" />
                        </DataTrigger>
                    </DataTemplate.Triggers>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</UserControl>
