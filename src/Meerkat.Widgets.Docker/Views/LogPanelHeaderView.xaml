<UserControl x:Class="Meerkat.Widgets.Docker.Views.LogPanelHeaderView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontSize="11">
    <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
            <Grid Width="170" Margin="0,0,8,0">
                <TextBox Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}" Padding="22,3,6,3" />
                <TextBlock Text="&#xE721;"
                           FontFamily="{DynamicResource Overlay.IconFont}"
                           FontSize="10"
                           Foreground="{DynamicResource Overlay.TextMuted}"
                           Margin="8,0,0,0"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Left"
                           IsHitTestVisible="False" />
                <TextBlock Text="Filter …" Margin="24,0,0,0" IsHitTestVisible="False">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource Overlay.Hint}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding FilterText}" Value="">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
            <ToggleButton Style="{DynamicResource Overlay.Chip}" Content="stdout" IsChecked="{Binding ShowStdout}" Margin="0,0,4,0" />
            <ToggleButton Style="{DynamicResource Overlay.Chip}" Content="stderr" IsChecked="{Binding ShowStderr}" Margin="0,0,8,0" />
            <Button Command="{Binding TogglePauseCommand}" Padding="8,3" FontSize="11" Focusable="False">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource Overlay.Button}">
                        <Setter Property="Content" Value="Pause" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsPaused}" Value="True">
                                <Setter Property="Content" Value="Resume" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
            <Button Style="{DynamicResource Overlay.IconButton}"
                    Content="&#xE74D;"
                    ToolTip="Clear"
                    Margin="6,0,0,0"
                    Command="{Binding ClearCommand}" />
            <Button Style="{DynamicResource Overlay.IconButton}"
                    Content="&#xE8BB;"
                    ToolTip="Close logs"
                    Command="{Binding CloseCommand}" />
        </StackPanel>

        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <Ellipse x:Name="LiveDot" Width="6" Height="6" Margin="0,1,6,0">
                <Ellipse.Style>
                    <Style TargetType="Ellipse">
                        <Setter Property="Fill" Value="{DynamicResource Overlay.TextMuted}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsLive}" Value="True">
                                <Setter Property="Fill" Value="{DynamicResource Overlay.Success}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Ellipse.Style>
            </Ellipse>
            <TextBlock FontWeight="SemiBold">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Text" Value="Ended" />
                        <Setter Property="Foreground" Value="{DynamicResource Overlay.TextMuted}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsLive}" Value="True">
                                <Setter Property="Text" Value="Live" />
                                <Setter Property="Foreground" Value="{DynamicResource Overlay.Success}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </StackPanel>
    </DockPanel>
</UserControl>
