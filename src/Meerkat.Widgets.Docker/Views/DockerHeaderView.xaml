<UserControl x:Class="Meerkat.Widgets.Docker.Views.DockerHeaderView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontSize="11">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </UserControl.Resources>
    <DockPanel>
        <!-- Display mode: passive summary on the right. -->
        <TextBlock DockPanel.Dock="Right"
                   Style="{DynamicResource Overlay.Hint}"
                   Text="{Binding Summary}"
                   Visibility="{Binding IsDisplayMode, Converter={StaticResource BoolToVisibility}}" />

        <!-- Interactive mode: the summary moves next to the distribution to make room for the buttons. -->
        <StackPanel DockPanel.Dock="Right"
                    Orientation="Horizontal"
                    Visibility="{Binding IsInteractive, Converter={StaticResource BoolToVisibility}}">
            <Button Style="{DynamicResource Overlay.IconButton}"
                    Content="&#xE72C;"
                    ToolTip="Refresh now"
                    Command="{Binding RefreshCommand}" />
            <Button Style="{DynamicResource Overlay.IconButton}"
                    Content="&#xE713;"
                    ToolTip="Settings"
                    Command="{Binding OpenSettingsCommand}" />
        </StackPanel>

        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <TextBlock Style="{DynamicResource Overlay.Hint}" Text="{Binding DistributionLabel}" />
            <TextBlock Style="{DynamicResource Overlay.Hint}"
                       Text="{Binding Summary, StringFormat=' · {0}'}"
                       Visibility="{Binding IsInteractive, Converter={StaticResource BoolToVisibility}}" />
        </StackPanel>
    </DockPanel>
</UserControl>
