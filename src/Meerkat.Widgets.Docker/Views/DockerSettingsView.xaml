<UserControl x:Class="Meerkat.Widgets.Docker.Views.DockerSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <Style x:Key="LinkButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{DynamicResource Overlay.Accent}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <TextBlock Text="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}" TextDecorations="Underline" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Overlay.TextMuted}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>
    </UserControl.Resources>
    <StackPanel>
    <TextBlock Style="{DynamicResource Overlay.ColumnHeader}" FontSize="10.5" Text="THIS MACHINE (WSL)" Margin="0,0,0,4" />
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="162" />
            <ColumnDefinition Width="142" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Grid.Column="0" Style="{DynamicResource Overlay.FormLabel}" Text="WSL distribution" />
        <ComboBox Grid.Row="0" Grid.Column="1" Margin="0,5"
                  ItemsSource="{Binding Distributions}"
                  SelectedItem="{Binding SelectedDistribution}"
                  DisplayMemberPath="DisplayName" />
        <TextBlock Grid.Row="0" Grid.Column="2" Style="{DynamicResource Overlay.Hint}" Margin="10,0,0,0"
                   FontFamily="{DynamicResource Overlay.MonoFont}" Text="wsl -d &lt;name&gt;" />

        <TextBlock Grid.Row="1" Grid.Column="0" Style="{DynamicResource Overlay.FormLabel}" Text="Container list interval" />
        <TextBox Grid.Row="1" Grid.Column="1" Margin="0,5" FontFamily="{DynamicResource Overlay.MonoFont}"
                 Text="{Binding ListIntervalSeconds}" />
        <TextBlock Grid.Row="1" Grid.Column="2" Style="{DynamicResource Overlay.Hint}" Margin="10,0,0,0" Text="seconds" />

        <TextBlock Grid.Row="2" Grid.Column="0" Style="{DynamicResource Overlay.FormLabel}" Text="Stats interval" />
        <TextBox Grid.Row="2" Grid.Column="1" Margin="0,5" FontFamily="{DynamicResource Overlay.MonoFont}"
                 Text="{Binding StatsIntervalSeconds}" />
        <TextBlock Grid.Row="2" Grid.Column="2" Style="{DynamicResource Overlay.Hint}" Margin="10,0,0,0" Text="seconds" />

        <TextBlock Grid.Row="3" Grid.Column="0" Style="{DynamicResource Overlay.FormLabel}" Text="Max. log lines" />
        <TextBox Grid.Row="3" Grid.Column="1" Margin="0,5" FontFamily="{DynamicResource Overlay.MonoFont}"
                 Text="{Binding MaxLogLines}" />
        <TextBlock Grid.Row="3" Grid.Column="2" Style="{DynamicResource Overlay.Hint}" Margin="10,0,0,0"
                   Text="Older lines are discarded" />
    </Grid>

    <DockPanel Margin="0,20,0,6">
        <Button DockPanel.Dock="Right" Content="+ Add host" Command="{Binding AddHostCommand}"
                Visibility="{Binding CanAddHosts, Converter={StaticResource BoolToVisibility}}" />
        <TextBlock Style="{DynamicResource Overlay.ColumnHeader}" FontSize="10.5" Text="OTHER MACHINES (SSH)" VerticalAlignment="Center" />
    </DockPanel>

    <ItemsControl ItemsSource="{Binding RemoteHosts}" Focusable="False">
        <ItemsControl.ItemTemplate>
            <DataTemplate>
                <Border BorderBrush="{DynamicResource Overlay.Border}" BorderThickness="0,0,0,1" Padding="0,7">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource Overlay.Text}" />
                        <TextBlock Grid.Column="1" Text="{Binding Address}" FontFamily="{DynamicResource Overlay.MonoFont}" FontSize="11" VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" Foreground="{DynamicResource Overlay.TextMuted}" />
                        <TextBlock x:Name="Access" Grid.Column="2" Text="read-only" FontSize="11" Margin="12,0" VerticalAlignment="Center" Foreground="{DynamicResource Overlay.TextMuted}" />
                        <StackPanel Grid.Column="3" Orientation="Horizontal">
                            <Button Style="{StaticResource LinkButton}" Content="Edit" Margin="0,0,12,0"
                                    Command="{Binding DataContext.EditHostCommand, ElementName=Root}" CommandParameter="{Binding}" />
                            <Button Style="{StaticResource LinkButton}" Content="Remove"
                                    Command="{Binding DataContext.RemoveHostCommand, ElementName=Root}" CommandParameter="{Binding}" />
                        </StackPanel>
                    </Grid>
                </Border>
                <DataTemplate.Triggers>
                    <DataTrigger Binding="{Binding AllowActions}" Value="True">
                        <Setter TargetName="Access" Property="Text" Value="start/stop allowed" />
                    </DataTrigger>
                </DataTemplate.Triggers>
            </DataTemplate>
        </ItemsControl.ItemTemplate>
    </ItemsControl>

    <TextBlock Style="{DynamicResource Overlay.Hint}" TextWrapping="Wrap" Margin="0,2,0,0"
               Text="Shows the containers of other machines by running the docker CLI there over SSH. The user you sign in with must be allowed to use Docker on the host, which usually means being in its docker group." />


    <Border Margin="0,12,0,0"
            Padding="16,14"
            CornerRadius="6"
            BorderThickness="1"
            BorderBrush="{DynamicResource Overlay.Accent}"
            Background="{DynamicResource Overlay.SurfaceSolid}"
            Visibility="{Binding IsFormOpen, Converter={StaticResource BoolToVisibility}}">
        <StackPanel>
            <TextBlock Text="{Binding FormTitle}" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource Overlay.Text}" Margin="0,0,0,10" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="130" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="110" />
                    <ColumnDefinition Width="70" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                    <TextBlock Style="{StaticResource FieldLabel}" Text="Name" />
                    <TextBox Text="{Binding HostName, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="0,0,10,0">
                    <TextBlock Style="{StaticResource FieldLabel}" Text="Host name or alias" />
                    <TextBox Text="{Binding HostAddress, UpdateSourceTrigger=PropertyChanged}" FontFamily="{DynamicResource Overlay.MonoFont}" />
                </StackPanel>
                <StackPanel Grid.Column="2" Margin="0,0,10,0">
                    <TextBlock Style="{StaticResource FieldLabel}" Text="User" />
                    <TextBox Text="{Binding HostUser, UpdateSourceTrigger=PropertyChanged}" FontFamily="{DynamicResource Overlay.MonoFont}" />
                </StackPanel>
                <StackPanel Grid.Column="3">
                    <TextBlock Style="{StaticResource FieldLabel}" Text="Port" />
                    <TextBox Text="{Binding HostPort, UpdateSourceTrigger=PropertyChanged}" FontFamily="{DynamicResource Overlay.MonoFont}" />
                </StackPanel>
            </Grid>

            <Grid Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="210" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                    <TextBlock Style="{StaticResource FieldLabel}" Text="Sign in with" />
                    <ComboBox ItemsSource="{Binding AuthenticationOptions}" SelectedItem="{Binding SelectedAuthentication}" DisplayMemberPath="DisplayName" />
                </StackPanel>
                <StackPanel Grid.Column="1" Visibility="{Binding UsesKeyFile, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Style="{StaticResource FieldLabel}" Text="Private key file" />
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="Browse …" Margin="8,0,0,0" Click="OnBrowseKeyFileClick" />
                        <TextBox Text="{Binding KeyFile, UpdateSourceTrigger=PropertyChanged}" FontFamily="{DynamicResource Overlay.MonoFont}" />
                    </DockPanel>
                </StackPanel>
                <StackPanel Grid.Column="1" Visibility="{Binding UsesPassword, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Style="{StaticResource FieldLabel}" Text="Password for the user" />
                    <Grid>
                        <PasswordBox x:Name="PasswordInput" PasswordChanged="OnPasswordChanged" />
                        <TextBlock x:Name="StoredPasswordHint" Text="●●●●●●●●  stored – type to replace" Margin="8,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"
                                   Foreground="{DynamicResource Overlay.TextMuted}" Visibility="Collapsed" />
                    </Grid>
                </StackPanel>
            </Grid>
            <TextBlock Style="{DynamicResource Overlay.Hint}" Margin="0,6,0,0" TextWrapping="Wrap"
                       Text="A password is kept in the Windows Credential Manager, not in the settings file. Where the host allows it, a key is the safer choice." 
                       Visibility="{Binding UsesPassword, Converter={StaticResource BoolToVisibility}}" />

            <Grid Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="210" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                    <TextBlock Style="{StaticResource FieldLabel}" Text="Ask the host" />
                    <ComboBox ItemsSource="{Binding HostIntervals}" SelectedItem="{Binding SelectedHostInterval}" DisplayMemberPath="DisplayName" />
                </StackPanel>
                <CheckBox Grid.Column="1" VerticalAlignment="Bottom" Margin="0,0,0,5" IsChecked="{Binding AllowActions}" Content="Allow starting, stopping and restarting containers" />
            </Grid>
            <TextBlock Style="{DynamicResource Overlay.Hint}" Margin="0,6,0,0" TextWrapping="Wrap"
                       Text="Every request opens an SSH connection, so other machines are asked less often than this one. Without the permission above the host is only read, which is the safe choice for a server others rely on." />

            <StackPanel Margin="0,10,0,0">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding FormError}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <TextBlock Text="{Binding FormError}" TextWrapping="Wrap" Foreground="{DynamicResource Overlay.Danger}" />
                <TextBlock Text="{Binding FormErrorDetail}" Margin="0,4,0,0" TextWrapping="Wrap" FontFamily="{DynamicResource Overlay.MonoFont}" FontSize="10.5"
                           Foreground="{DynamicResource Overlay.TextMuted}" MaxHeight="60" TextTrimming="CharacterEllipsis" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                <Button Style="{DynamicResource Overlay.PrimaryButton}" Content="Connect and check" Margin="0,0,8,0" Command="{Binding ConnectAndCheckCommand}" />
                <Button Content="Cancel" Command="{Binding CancelFormCommand}" />
                <TextBlock Text="Connecting …" Margin="12,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource Overlay.TextMuted}"
                           Visibility="{Binding IsChecking, Converter={StaticResource BoolToVisibility}}" />
            </StackPanel>
        </StackPanel>
    </Border>
    </StackPanel>
</UserControl>