<UserControl x:Class="Meerkat.Widgets.Docker.Views.DockerSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <Style x:Key="LinkButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{DynamicResource Overlay.Accent}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <TextBlock Text="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}" TextDecorations="Underline" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ErrorText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Overlay.Danger}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="MaxHeight" Value="46" />
            <Style.Triggers>
                <Trigger Property="Text" Value="">
                    <Setter Property="Visibility" Value="Collapsed" />
                </Trigger>
                <Trigger Property="Text" Value="{x:Null}">
                    <Setter Property="Visibility" Value="Collapsed" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="Badge" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Overlay.SurfaceRaised}" />
            <Setter Property="CornerRadius" Value="9" />
            <Setter Property="Padding" Value="8,2" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="ResultText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Overlay.Success}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsCheckFailed}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource Overlay.Danger}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding CheckResult}" Value="">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <StackPanel>
        <TextBlock Style="{DynamicResource Overlay.ColumnHeader}" FontSize="10.5" Text="THIS COMPUTER" Margin="0,0,0,4" />
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="170" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Style="{DynamicResource Overlay.FormLabel}" Text="WSL distribution" />
            <ComboBox Grid.Row="0" Grid.Column="1" Margin="0,5" Width="190" HorizontalAlignment="Left"
                      ItemsSource="{Binding Distributions}"
                      SelectedItem="{Binding SelectedDistribution}"
                      DisplayMemberPath="DisplayName" />

            <StackPanel Grid.Row="1" Grid.Column="0" Orientation="Horizontal">
                <TextBlock Style="{DynamicResource Overlay.FormLabel}" Text="Refresh" />
                <ContentControl Style="{DynamicResource Overlay.Info}" ToolTip="{Binding RefreshInfo}" />
            </StackPanel>
            <Border Grid.Row="1" Grid.Column="1" Margin="0,5" HorizontalAlignment="Left" CornerRadius="5" BorderThickness="1"
                    BorderBrush="{DynamicResource Overlay.Border}" Background="{DynamicResource Overlay.SurfaceRaised}">
                <StackPanel Orientation="Horizontal">
                    <RadioButton Style="{DynamicResource Overlay.Segment}" GroupName="DockerRefresh" Content="Fast" IsChecked="{Binding IsFast}" />
                    <RadioButton Style="{DynamicResource Overlay.Segment}" GroupName="DockerRefresh" Content="Normal" IsChecked="{Binding IsNormal}" />
                    <RadioButton Style="{DynamicResource Overlay.Segment}" GroupName="DockerRefresh" Content="Economical" IsChecked="{Binding IsEconomical}" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- The machines are entered elsewhere, once for all widgets; here one of them is picked and what the widget does with it. -->
        <DockPanel Margin="0,20,0,4">
            <Grid DockPanel.Dock="Right" ToolTip="{Binding AddMachineHint}" ToolTipService.ShowOnDisabled="True">
                <ToggleButton x:Name="AddMachineButton" Content="+ Machine" IsChecked="{Binding IsPickerOpen}" IsEnabled="{Binding CanAddMachine}">
                    <ToggleButton.Style>
                        <Style TargetType="ToggleButton" BasedOn="{StaticResource Overlay.Button}">
                            <Style.Triggers>
                                <!-- While the list is open a click on the button only closes it, which the list does by itself. -->
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter Property="IsHitTestVisible" Value="False" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </ToggleButton.Style>
                </ToggleButton>
                <Popup IsOpen="{Binding IsPickerOpen}" StaysOpen="False" PlacementTarget="{Binding ElementName=AddMachineButton}" Placement="Bottom"
                       HorizontalOffset="0" VerticalOffset="4" AllowsTransparency="True">
                    <Border Background="{DynamicResource Overlay.SurfaceRaised}" BorderBrush="{DynamicResource Overlay.Border}" BorderThickness="1" CornerRadius="6" Padding="4" MinWidth="220">
                        <ItemsControl ItemsSource="{Binding AvailableMachines}" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Cursor="Hand" HorizontalContentAlignment="Stretch"
                                            Command="{Binding DataContext.AddMachineCommand, ElementName=Root}" CommandParameter="{Binding}">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="Chrome" Background="Transparent" CornerRadius="4" Padding="8,5">
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" Foreground="{DynamicResource Overlay.Text}" />
                                                        <TextBlock Text="{Binding Destination}" FontFamily="{DynamicResource Overlay.MonoFont}" FontSize="10.5"
                                                                   Foreground="{DynamicResource Overlay.TextMuted}" />
                                                    </StackPanel>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Overlay.Hover}" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>
                </Popup>
            </Grid>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Style="{DynamicResource Overlay.ColumnHeader}" FontSize="10.5" Text="OTHER MACHINES" VerticalAlignment="Center" />
                <ContentControl Style="{DynamicResource Overlay.Info}" ToolTip="{Binding MachinesInfo}" />
            </StackPanel>
        </DockPanel>
        <ItemsControl ItemsSource="{Binding Machines}" Focusable="False">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border BorderBrush="{DynamicResource Overlay.Border}" BorderThickness="0,0,0,1" Padding="0,7">
                        <StackPanel>
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Style="{StaticResource LinkButton}" Content="Edit" VerticalAlignment="Center" Margin="12,0,0,0"
                                        Command="{Binding ToggleOpenCommand}" />
                                <Border DockPanel.Dock="Right" Style="{StaticResource Badge}">
                                    <TextBlock Text="{Binding AccessText}" FontSize="11" Foreground="{DynamicResource Overlay.TextMuted}" />
                                </Border>
                                <StackPanel Margin="0,0,10,0">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource Overlay.Text}" />
                                    <TextBlock Text="{Binding Destination}" FontFamily="{DynamicResource Overlay.MonoFont}" FontSize="10.5" TextTrimming="CharacterEllipsis"
                                               Foreground="{DynamicResource Overlay.TextMuted}" />
                                </StackPanel>
                            </DockPanel>

                            <Border Margin="0,8,0,2" Padding="14,12" CornerRadius="6" BorderThickness="1" BorderBrush="{DynamicResource Overlay.Border}"
                                    Background="{DynamicResource Overlay.SurfaceRaised}"
                                    Visibility="{Binding IsOpen, Converter={StaticResource BoolToVisibility}}">
                                <StackPanel>
                                    <CheckBox Content="Allow starting, stopping and restarting containers" IsChecked="{Binding AllowActions}" />
                                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                        <CheckBox Content="Scan images for vulnerabilities" IsChecked="{Binding ScanImages}" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding Scanner.Text}" FontSize="11" VerticalAlignment="Center" Margin="14,0,8,0" Foreground="{DynamicResource Overlay.TextMuted}" />
                                        <Button Style="{StaticResource LinkButton}" Content="Install Trivy" VerticalAlignment="Center" Command="{Binding Scanner.InstallCommand}"
                                                ToolTip="{Binding DataContext.ScannerInfo, ElementName=Root}"
                                                Visibility="{Binding Scanner.CanInstall, Converter={StaticResource BoolToVisibility}}" />
                                    </StackPanel>
                                    <TextBlock Style="{StaticResource ErrorText}" Text="{Binding Scanner.Error}" Margin="0,6,0,0" />
                                    <TextBlock Style="{StaticResource ResultText}" Text="{Binding CheckResult}" Margin="0,8,0,0" />
                                    <DockPanel Margin="0,12,0,0">
                                        <Button DockPanel.Dock="Right" Content="Remove" Foreground="{DynamicResource Overlay.Danger}"
                                                ToolTip="Takes the machine off the Docker widget. It stays on the Machines page."
                                                Command="{Binding DataContext.RemoveMachineCommand, ElementName=Root}" CommandParameter="{Binding}" />
                                        <StackPanel Orientation="Horizontal">
                                            <Button Style="{DynamicResource Overlay.PrimaryButton}" Content="Connect and check" Command="{Binding CheckCommand}"
                                                    Visibility="{Binding CanCheck, Converter={StaticResource BoolToVisibility}}" />
                                            <Button Content="Close" Margin="8,0,0,0" Command="{Binding ToggleOpenCommand}" />
                                        </StackPanel>
                                    </DockPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>        <TextBlock Text="No other machines. Add one with “+ Machine”." Margin="0,2,0,0">
            <TextBlock.Style>
                <Style TargetType="TextBlock" BasedOn="{StaticResource Overlay.Hint}">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HasMachines}" Value="False">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>
        <StackPanel Orientation="Horizontal" Margin="0,20,0,4">
            <TextBlock Style="{DynamicResource Overlay.ColumnHeader}" FontSize="10.5" Text="IMAGE SCAN" VerticalAlignment="Center" />
            <ContentControl Style="{DynamicResource Overlay.Info}" ToolTip="{Binding ScannerInfo}" />
        </StackPanel>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="170" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Style="{DynamicResource Overlay.FormLabel}" Text="This computer" />
            <StackPanel Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,5">
                <CheckBox Content="Scan images" IsChecked="{Binding ScanLocalImages}" VerticalAlignment="Center" Margin="0,0,16,0" />
                <TextBlock Text="{Binding LocalScanner.Text}" FontSize="11" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{DynamicResource Overlay.TextMuted}" />
                <Button Style="{StaticResource LinkButton}" Content="Install Trivy" VerticalAlignment="Center" Command="{Binding LocalScanner.InstallCommand}"
                        ToolTip="{Binding ScannerInfo}"
                        Visibility="{Binding LocalScanner.CanInstall, Converter={StaticResource BoolToVisibility}}" />
            </StackPanel>

            <TextBlock Grid.Row="1" Grid.Column="0" Style="{DynamicResource Overlay.FormLabel}" Text="Report from" />
            <ComboBox Grid.Row="1" Grid.Column="1" Margin="0,5" Width="190" HorizontalAlignment="Left"
                      ItemsSource="{Binding Thresholds}" SelectedItem="{Binding SelectedThreshold}" DisplayMemberPath="DisplayName" />

            <TextBlock Grid.Row="2" Grid.Column="0" Style="{DynamicResource Overlay.FormLabel}" Text="Scan daily at" />
            <TextBox Grid.Row="2" Grid.Column="1" Margin="0,5" Width="80" HorizontalAlignment="Left" FontFamily="{DynamicResource Overlay.MonoFont}"
                     Text="{Binding DailyScanTime, UpdateSourceTrigger=PropertyChanged}" />
            <TextBlock Grid.Row="2" Grid.Column="2" Style="{StaticResource ErrorText}" Text="{Binding DailyScanTimeError}" Margin="10,0,0,0" VerticalAlignment="Center" />
        </Grid>
        <TextBlock Style="{StaticResource ErrorText}" Text="{Binding LocalScanner.Error}" Margin="170,0,0,0" />
        <CheckBox Margin="0,8,0,0" IsChecked="{Binding OnlyFixable}" Content="Only vulnerabilities with an available fix" />
        <CheckBox Margin="0,8,0,0" IsChecked="{Binding SkipOnBattery}" Content="Do not scan this computer on battery power" />

        <StackPanel Visibility="{Binding HasIgnored, Converter={StaticResource BoolToVisibility}}">
            <Button Style="{StaticResource LinkButton}" Content="{Binding IgnoredLinkText}" HorizontalAlignment="Left" Margin="0,10,0,0" Command="{Binding ToggleIgnoredListCommand}" />
            <ItemsControl ItemsSource="{Binding Ignored}" Focusable="False" Margin="0,6,0,0"
                          Visibility="{Binding IsIgnoredListOpen, Converter={StaticResource BoolToVisibility}}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="{DynamicResource Overlay.Border}" BorderThickness="0,0,0,1" Padding="0,6">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="170" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Id}" FontFamily="{DynamicResource Overlay.MonoFont}" FontSize="11" VerticalAlignment="Center" Foreground="{DynamicResource Overlay.Text}" />
                                <TextBlock Grid.Column="1" Text="{Binding Package}" FontFamily="{DynamicResource Overlay.MonoFont}" FontSize="11" VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" Foreground="{DynamicResource Overlay.TextMuted}" />
                                <TextBlock Grid.Column="2" Text="{Binding IgnoredAt, StringFormat='ignored {0:d}'}" FontSize="11" Margin="12,0" VerticalAlignment="Center" Foreground="{DynamicResource Overlay.TextMuted}" />
                                <Button Grid.Column="3" Style="{StaticResource LinkButton}" Content="Restore"
                                        Command="{Binding DataContext.RestoreIgnoredCommand, ElementName=Root}" CommandParameter="{Binding}" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </StackPanel>
</UserControl>
