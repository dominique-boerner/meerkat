<UserControl x:Class="Meerkat.Widgets.Server.Views.ServerWidgetView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:Meerkat.Widgets.Server.Views"
             x:Name="Root"
             Foreground="{DynamicResource Overlay.Text}"
             FontSize="12">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <SolidColorBrush x:Key="DangerSurface" Color="#24FF6B6B" />
        <SolidColorBrush x:Key="SuccessSurface" Color="#1F3FCF8E" />

        <Style x:Key="SectionLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Overlay.TextMuted}" />
            <Setter Property="FontSize" Value="11" />
        </Style>
        <Style x:Key="MonoValue" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{DynamicResource Overlay.MonoFont}" />
            <Setter Property="FontSize" Value="11" />
        </Style>

        <!-- Small dot in the color of a severity; expects a WidgetSeverity as data context. -->
        <DataTemplate x:Key="SeverityDot">
            <Ellipse x:Name="Dot" Width="8" Height="8" Fill="{DynamicResource Overlay.Success}" />
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding}" Value="Warning">
                    <Setter TargetName="Dot" Property="Fill" Value="{DynamicResource Overlay.Warning}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding}" Value="Error">
                    <Setter TargetName="Dot" Property="Fill" Value="{DynamicResource Overlay.Danger}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <DataTemplate x:Key="ServiceChip">
            <Border x:Name="Chip" CornerRadius="10" Padding="8,2" Margin="0,0,6,4" Background="{DynamicResource Overlay.WarningSurface}">
                <StackPanel Orientation="Horizontal">
                    <Ellipse x:Name="Dot" Width="6" Height="6" Margin="0,1,6,0" Fill="{DynamicResource Overlay.Warning}" />
                    <TextBlock Text="{Binding Name}" Style="{StaticResource MonoValue}" />
                    <TextBlock x:Name="State" Text="{Binding StateText}" FontSize="11" Margin="6,0,0,0" />
                </StackPanel>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsActive}" Value="True">
                    <Setter TargetName="Chip" Property="Background" Value="{DynamicResource Overlay.SurfaceRaised}" />
                    <Setter TargetName="Dot" Property="Fill" Value="{DynamicResource Overlay.Success}" />
                    <Setter TargetName="State" Property="Foreground" Value="{DynamicResource Overlay.TextMuted}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <DataTemplate x:Key="HostTemplate">
            <StackPanel Margin="0,0,0,10">

                <!-- Not reachable or sign-in refused -->
                <Border Background="{StaticResource DangerSurface}"
                        BorderBrush="{DynamicResource Overlay.Danger}"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="12,9"
                        Visibility="{Binding IsConnectionFailure, Converter={StaticResource BoolToVisibility}}">
                    <DockPanel>
                        <Button DockPanel.Dock="Right"
                                Content="Check again"
                                VerticalAlignment="Center"
                                Margin="10,0,0,0"
                                Command="{Binding DataContext.RecheckCommand, ElementName=Root}"
                                CommandParameter="{Binding}" />
                        <Grid DockPanel.Dock="Left" Width="18" Height="18" Margin="0,0,12,0" VerticalAlignment="Center">
                            <Ellipse Fill="{DynamicResource Overlay.Danger}" />
                            <TextBlock Text="&#xE711;"
                                       FontFamily="{DynamicResource Overlay.IconFont}"
                                       FontSize="9"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource Overlay.SurfaceSolid}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Grid>
                        <StackPanel>
                            <TextBlock TextTrimming="CharacterEllipsis">
                                <Run Text="{Binding Name, Mode=OneWay}" FontWeight="SemiBold" FontSize="13" />
                                <Run Text="{Binding Address, Mode=OneWay}"
                                     FontFamily="{DynamicResource Overlay.MonoFont}"
                                     FontSize="10.5"
                                     Foreground="{DynamicResource Overlay.TextMuted}" />
                            </TextBlock>
                            <TextBlock Text="{Binding FailureText}" TextWrapping="Wrap" />
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- Host key changed or unknown: connecting again needs a decision -->
                <Border Background="{StaticResource DangerSurface}"
                        BorderBrush="{DynamicResource Overlay.Danger}"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="12,10"
                        Visibility="{Binding IsHostKeyProblem, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel>
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Left"
                                       Text="&#xEA18;"
                                       FontFamily="{DynamicResource Overlay.IconFont}"
                                       FontSize="14"
                                       Foreground="{DynamicResource Overlay.Danger}"
                                       VerticalAlignment="Center"
                                       Margin="0,0,10,0" />
                            <TextBlock Text="{Binding FailureTitle}" FontWeight="SemiBold" FontSize="13" />
                        </DockPanel>
                        <TextBlock Text="{Binding FailureText}" TextWrapping="Wrap" Margin="24,4,0,0" />
                        <Border Background="{DynamicResource Overlay.SurfaceSolid}" CornerRadius="4" Padding="10,6" Margin="0,10,0,0">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Fingerprint}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="{Binding Fingerprint}" Style="{StaticResource MonoValue}" TextTrimming="CharacterEllipsis" />
                        </Border>
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <Button Content="Trust new key"
                                    Command="{Binding DataContext.TrustHostKeyCommand, ElementName=Root}"
                                    CommandParameter="{Binding}" />
                            <Button Content="Pause host"
                                    Margin="8,0,0,0"
                                    Command="{Binding DataContext.PauseHostCommand, ElementName=Root}"
                                    CommandParameter="{Binding}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Not checked yet, or paused -->
                <Border BorderBrush="{DynamicResource Overlay.Border}"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="12,9"
                        Visibility="{Binding IsIdle, Converter={StaticResource BoolToVisibility}}">
                    <DockPanel>
                        <Button DockPanel.Dock="Right"
                                Content="Resume"
                                Command="{Binding DataContext.ResumeHostCommand, ElementName=Root}"
                                CommandParameter="{Binding}"
                                Visibility="{Binding IsPaused, Converter={StaticResource BoolToVisibility}}" />
                        <Ellipse DockPanel.Dock="Left" Width="8" Height="8" Margin="0,0,10,0" Fill="{DynamicResource Overlay.TextMuted}" />
                        <TextBlock VerticalAlignment="Center">
                            <Run Text="{Binding Name, Mode=OneWay}" FontWeight="SemiBold" />
                            <Run>
                                <Run.Style>
                                    <Style TargetType="Run">
                                        <Setter Property="Text" Value="· checking …" />
                                        <Setter Property="Foreground" Value="{DynamicResource Overlay.TextMuted}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsPaused}" Value="True">
                                                <Setter Property="Text" Value="· paused" />
                                                <Setter Property="Foreground" Value="{DynamicResource Overlay.Warning}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Run.Style>
                            </Run>
                        </TextBlock>
                    </DockPanel>
                </Border>

                <!-- Online: one line while everything is fine, details when opened -->
                <Border BorderBrush="{DynamicResource Overlay.Border}"
                        BorderThickness="1"
                        CornerRadius="6"
                        Visibility="{Binding IsOnline, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel>
                        <Button Command="{Binding DataContext.ToggleExpandedCommand, ElementName=Root}"
                                CommandParameter="{Binding}"
                                AutomationProperties.Name="{Binding Name}"
                                Cursor="Hand"
                                Focusable="False">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="Transparent" Padding="12,10">
                                        <DockPanel>
                                            <ContentControl DockPanel.Dock="Left"
                                                            Content="{Binding Severity}"
                                                            ContentTemplate="{StaticResource SeverityDot}"
                                                            VerticalAlignment="Center"
                                                            Margin="0,0,10,0"
                                                            Focusable="False" />
                                            <!-- Collapsed: the three figures that matter at a glance -->
                                            <StackPanel x:Name="Compact" DockPanel.Dock="Right" Orientation="Horizontal">
                                                <TextBlock Text="{Binding CompactLoad}" Style="{StaticResource MonoValue}" Width="90" />
                                                <TextBlock Text="{Binding CompactRam}" Style="{StaticResource MonoValue}" Width="80" />
                                                <TextBlock Text="{Binding CompactDisk}" Style="{StaticResource MonoValue}" Width="74" />
                                            </StackPanel>
                                            <TextBlock TextTrimming="CharacterEllipsis" VerticalAlignment="Center">
                                                <Run Text="{Binding Name, Mode=OneWay}" FontWeight="SemiBold" FontSize="13" />
                                                <Run Text="{Binding Address, Mode=OneWay}"
                                                     FontFamily="{DynamicResource Overlay.MonoFont}"
                                                     FontSize="10.5"
                                                     Foreground="{DynamicResource Overlay.TextMuted}" />
                                                <Run x:Name="Detail" Text="{Binding CompactUptime, Mode=OneWay, StringFormat='· {0}'}" Foreground="{DynamicResource Overlay.TextMuted}" />
                                            </TextBlock>
                                        </DockPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                                            <Setter TargetName="Compact" Property="Visibility" Value="Collapsed" />
                                            <Setter TargetName="Detail" Property="Text" Value="{Binding OsText, Mode=OneWay}" />
                                        </DataTrigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <StackPanel Margin="12,0,12,10" Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVisibility}}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="170" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Right" Style="{StaticResource MonoValue}">
                                            <Run Text="current" Foreground="{DynamicResource Overlay.TextMuted}" />
                                            <Run Text="{Binding CpuText, Mode=OneWay}" />
                                        </TextBlock>
                                        <TextBlock Style="{StaticResource SectionLabel}" Text="CPU · last 30 min" />
                                    </DockPanel>
                                    <Border Height="44" Margin="0,6,0,0" BorderBrush="{DynamicResource Overlay.Border}" BorderThickness="0,0,0,1">
                                        <views:Sparkline Values="{Binding CpuHistory}" Stroke="{DynamicResource Overlay.Accent}" Margin="0,2" />
                                    </Border>
                                </StackPanel>
                                <StackPanel Grid.Column="1" VerticalAlignment="Bottom">
                                    <TextBlock Style="{StaticResource SectionLabel}" Text="Load 1 / 5 / 15 min" />
                                    <TextBlock Text="{Binding LoadText}" FontFamily="{DynamicResource Overlay.MonoFont}" FontSize="14" Margin="0,4,0,2" />
                                    <TextBlock Style="{StaticResource SectionLabel}" Text="{Binding CoresText}" />
                                </StackPanel>
                            </Grid>

                            <Grid Margin="0,14,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="20" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding RamText}" Style="{StaticResource MonoValue}" />
                                        <TextBlock Style="{StaticResource SectionLabel}" Text="RAM" />
                                    </DockPanel>
                                    <ProgressBar Style="{DynamicResource Overlay.Meter}" Height="3" Margin="0,6,0,0" Maximum="100" Value="{Binding RamPercent, Mode=OneWay}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <DockPanel>
                                        <TextBlock x:Name="DiskValue" DockPanel.Dock="Right" Text="{Binding DiskText}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource MonoValue}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding DiskSeverity}" Value="Warning">
                                                            <Setter Property="Foreground" Value="{DynamicResource Overlay.Warning}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding DiskSeverity}" Value="Error">
                                                            <Setter Property="Foreground" Value="{DynamicResource Overlay.Danger}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Style="{StaticResource SectionLabel}" Text="Disk" />
                                    </DockPanel>
                                    <ProgressBar Height="3" Margin="0,6,0,0" Maximum="100" Value="{Binding DiskPercent, Mode=OneWay}">
                                        <ProgressBar.Style>
                                            <Style TargetType="ProgressBar" BasedOn="{StaticResource Overlay.Meter}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding DiskSeverity}" Value="Warning">
                                                        <Setter Property="Foreground" Value="{DynamicResource Overlay.Warning}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding DiskSeverity}" Value="Error">
                                                        <Setter Property="Foreground" Value="{DynamicResource Overlay.Danger}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ProgressBar.Style>
                                    </ProgressBar>
                                </StackPanel>
                            </Grid>

                            <StackPanel Margin="0,14,0,0">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Services.Count}" Value="0">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <TextBlock Style="{StaticResource SectionLabel}" Text="Services" />
                                <ItemsControl ItemsSource="{Binding Services}" ItemTemplate="{StaticResource ServiceChip}" Margin="0,6,0,0" Focusable="False">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                </ItemsControl>
                            </StackPanel>

                            <Border BorderBrush="{DynamicResource Overlay.Border}" BorderThickness="0,1,0,0" Margin="0,8,0,0" Padding="0,8,0,0">
                                <DockPanel>
                                    <Button DockPanel.Dock="Right"
                                            Content="Open terminal"
                                            Command="{Binding DataContext.OpenTerminalCommand, ElementName=Root}"
                                            CommandParameter="{Binding}" />
                                    <TextBlock Style="{StaticResource SectionLabel}" Text="{Binding FooterText}" VerticalAlignment="Center" />
                                </DockPanel>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>

    <DockPanel>
        <TextBlock DockPanel.Dock="Bottom"
                   Text="{Binding ActionError}"
                   Foreground="{DynamicResource Overlay.Danger}"
                   FontSize="11"
                   TextWrapping="Wrap"
                   Margin="0,4,0,0">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ActionError}" Value="{x:Null}">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>

        <Grid>
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                <ItemsControl ItemsSource="{Binding Hosts}" ItemTemplate="{StaticResource HostTemplate}" Focusable="False" />
            </ScrollViewer>

            <Border BorderBrush="{DynamicResource Overlay.Border}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="12,10"
                    VerticalAlignment="Top"
                    Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                    <TextBlock Text="No hosts yet" FontWeight="SemiBold" FontSize="13" />
                    <TextBlock Text="Add the machines you want to keep an eye on. Meerkat connects with your SSH configuration and keys."
                               TextWrapping="Wrap"
                               Margin="0,4,0,0" />
                    <Button Content="Settings" HorizontalAlignment="Left" Margin="0,10,0,0" Command="{Binding OpenSettingsCommand}" />
                </StackPanel>
            </Border>
        </Grid>
    </DockPanel>
</UserControl>
