<UserControl x:Class="Meerkat.Widgets.Server.Views.ServerSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <Style x:Key="LinkButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{DynamicResource Overlay.Accent}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <TextBlock Text="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}" TextDecorations="Underline" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Overlay.TextMuted}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>
        <Style x:Key="Badge" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Overlay.SurfaceRaised}" />
            <Setter Property="CornerRadius" Value="9" />
            <Setter Property="Padding" Value="8,2" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="ResultText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Overlay.Success}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsCheckFailed}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource Overlay.Danger}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding CheckResult}" Value="">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <StackPanel>
        <StackPanel Orientation="Horizontal">
            <StackPanel Orientation="Horizontal" Width="170">
                <TextBlock Style="{DynamicResource Overlay.FormLabel}" Text="Refresh" />
                <ContentControl Style="{DynamicResource Overlay.Info}" ToolTip="{Binding RefreshInfo}" />
            </StackPanel>
            <Border CornerRadius="5" BorderThickness="1" BorderBrush="{DynamicResource Overlay.Border}" Background="{DynamicResource Overlay.SurfaceRaised}">
                <StackPanel Orientation="Horizontal">
                    <RadioButton Style="{DynamicResource Overlay.Segment}" GroupName="ServerRefresh" Content="Fast" IsChecked="{Binding IsFast}" />
                    <RadioButton Style="{DynamicResource Overlay.Segment}" GroupName="ServerRefresh" Content="Normal" IsChecked="{Binding IsNormal}" />
                    <RadioButton Style="{DynamicResource Overlay.Segment}" GroupName="ServerRefresh" Content="Economical" IsChecked="{Binding IsEconomical}" />
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- The machines are entered elsewhere, once for all widgets; here one of them is picked and what the widget does with it. -->
        <DockPanel Margin="0,20,0,4">
            <Grid DockPanel.Dock="Right" ToolTip="{Binding AddMachineHint}" ToolTipService.ShowOnDisabled="True">
                <ToggleButton x:Name="AddMachineButton" Content="+ Machine" IsChecked="{Binding IsPickerOpen}" IsEnabled="{Binding CanAddMachine}">
                    <ToggleButton.Style>
                        <Style TargetType="ToggleButton" BasedOn="{StaticResource Overlay.Button}">
                            <Style.Triggers>
                                <!-- While the list is open a click on the button only closes it, which the list does by itself. -->
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter Property="IsHitTestVisible" Value="False" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </ToggleButton.Style>
                </ToggleButton>
                <Popup IsOpen="{Binding IsPickerOpen}" StaysOpen="False" PlacementTarget="{Binding ElementName=AddMachineButton}" Placement="Bottom"
                       HorizontalOffset="0" VerticalOffset="4" AllowsTransparency="True">
                    <Border Background="{DynamicResource Overlay.SurfaceRaised}" BorderBrush="{DynamicResource Overlay.Border}" BorderThickness="1" CornerRadius="6" Padding="4" MinWidth="220">
                        <ItemsControl ItemsSource="{Binding AvailableMachines}" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Cursor="Hand" HorizontalContentAlignment="Stretch"
                                            Command="{Binding DataContext.AddMachineCommand, ElementName=Root}" CommandParameter="{Binding}">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="Chrome" Background="Transparent" CornerRadius="4" Padding="8,5">
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" Foreground="{DynamicResource Overlay.Text}" />
                                                        <TextBlock Text="{Binding Destination}" FontFamily="{DynamicResource Overlay.MonoFont}" FontSize="10.5"
                                                                   Foreground="{DynamicResource Overlay.TextMuted}" />
                                                    </StackPanel>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Overlay.Hover}" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>
                </Popup>
            </Grid>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Style="{DynamicResource Overlay.ColumnHeader}" FontSize="10.5" Text="MACHINES" VerticalAlignment="Center" />
                <ContentControl Style="{DynamicResource Overlay.Info}" ToolTip="{Binding MachinesInfo}" />
            </StackPanel>
        </DockPanel>
        <ItemsControl ItemsSource="{Binding Machines}" Focusable="False">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border BorderBrush="{DynamicResource Overlay.Border}" BorderThickness="0,0,0,1" Padding="0,7">
                        <StackPanel>
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Style="{StaticResource LinkButton}" Content="Edit" VerticalAlignment="Center" Margin="12,0,0,0"
                                        Command="{Binding ToggleOpenCommand}" />
                                <Border DockPanel.Dock="Right" Style="{StaticResource Badge}" MaxWidth="260">
                                    <TextBlock Text="{Binding Summary}" FontSize="11" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource Overlay.TextMuted}" />
                                </Border>
                                <StackPanel Margin="0,0,10,0">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource Overlay.Text}" />
                                    <TextBlock Text="{Binding Destination}" FontFamily="{DynamicResource Overlay.MonoFont}" FontSize="10.5" TextTrimming="CharacterEllipsis"
                                               Foreground="{DynamicResource Overlay.TextMuted}" />
                                </StackPanel>
                            </DockPanel>

                            <Border Margin="0,8,0,2" Padding="14,12" CornerRadius="6" BorderThickness="1" BorderBrush="{DynamicResource Overlay.Border}"
                                    Background="{DynamicResource Overlay.SurfaceRaised}"
                                    Visibility="{Binding IsOpen, Converter={StaticResource BoolToVisibility}}">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="10" />
                                            <ColumnDefinition Width="90" />
                                            <ColumnDefinition Width="10" />
                                            <ColumnDefinition Width="90" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Style="{StaticResource FieldLabel}" Text="Services to watch (systemd)" />
                                            <TextBox Text="{Binding ServicesText}" FontFamily="{DynamicResource Overlay.MonoFont}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Style="{StaticResource FieldLabel}" Text="Disk yellow %" />
                                            <TextBox Text="{Binding DiskWarningPercent}" FontFamily="{DynamicResource Overlay.MonoFont}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="4">
                                            <TextBlock Style="{StaticResource FieldLabel}" Text="Disk red %" />
                                            <TextBox Text="{Binding DiskErrorPercent}" FontFamily="{DynamicResource Overlay.MonoFont}" />
                                        </StackPanel>
                                    </Grid>
                                    <CheckBox Content="Paused (not checked)" IsChecked="{Binding IsPaused}" Margin="0,10,0,0" />
                                    <TextBlock Text="{Binding Error}" Foreground="{DynamicResource Overlay.Danger}" FontSize="11" TextWrapping="Wrap" Margin="0,8,0,0">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Error}" Value="{x:Null}">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock Style="{StaticResource ResultText}" Text="{Binding CheckResult}" Margin="0,8,0,0" />
                                    <DockPanel Margin="0,12,0,0">
                                        <Button DockPanel.Dock="Right" Content="Remove" Foreground="{DynamicResource Overlay.Danger}"
                                                ToolTip="Takes the machine off the Server widget. It stays on the Machines page."
                                                Command="{Binding DataContext.RemoveMachineCommand, ElementName=Root}" CommandParameter="{Binding}" />
                                        <StackPanel Orientation="Horizontal">
                                            <Button Style="{DynamicResource Overlay.PrimaryButton}" Content="Connect and check" Command="{Binding CheckCommand}"
                                                    Visibility="{Binding CanCheck, Converter={StaticResource BoolToVisibility}}" />
                                            <Button Content="Close" Margin="8,0,0,0" Command="{Binding ToggleOpenCommand}" />
                                        </StackPanel>
                                    </DockPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>        <TextBlock Text="No machines. Add one with “+ Machine”." Margin="0,2,0,0">
            <TextBlock.Style>
                <Style TargetType="TextBlock" BasedOn="{StaticResource Overlay.Hint}">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HasMachines}" Value="False">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>
    </StackPanel>
</UserControl>
