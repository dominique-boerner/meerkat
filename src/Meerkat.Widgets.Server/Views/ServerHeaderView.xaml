<UserControl x:Class="Meerkat.Widgets.Server.Views.ServerHeaderView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontSize="11">
    <DockPanel>
        <Button DockPanel.Dock="Right"
                Style="{DynamicResource Overlay.IconButton}"
                Content="&#xE713;"
                ToolTip="Server settings"
                Command="{Binding OpenSettingsCommand}" />
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <TextBlock Style="{DynamicResource Overlay.ColumnHeader}" FontSize="10.5" Text="SERVER" />
            <TextBlock Style="{DynamicResource Overlay.Hint}" Text="{Binding Summary, StringFormat=' · {0}'}" />
        </StackPanel>
    </DockPanel>
</UserControl>
