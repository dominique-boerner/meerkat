<Project>
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <AnalysisLevel>latest</AnalysisLevel>
  </PropertyGroup>
  <PropertyGroup>
    <!-- Local builds use this version; the release pipeline overrides it with the Git tag. -->
    <Version>1.1.0</Version>
    <Product>Meerkat</Product>
    <Description>A click-through desktop overlay for developers, built from widgets.</Description>
    <Copyright>Copyright (c) Meerkat contributors</Copyright>
    <NeutralLanguage>en</NeutralLanguage>
    <RepositoryUrl>https://github.com/dominique-boerner/meerkat</RepositoryUrl>
  </PropertyGroup>
</Project>
